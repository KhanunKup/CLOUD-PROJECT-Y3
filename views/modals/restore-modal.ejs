<!-- views/modals/restore-modal.ejs -->
<link rel="stylesheet" href="/css/restore-modal.css">

<div class="restore-modal-overlay" id="restoreModal" style="display: none;">
    <div class="restore-modal" role="dialog" aria-modal="true" aria-labelledby="restoreModalTitle">
        <h2 class="restore-modal-title" id="restoreModalTitle">Restore File</h2>
        <div class="restore-modal-body">
            Are you sure you want to restore <span class="restore-filename-highlight" id="restoreTargetName">this item</span>?
        </div>
        <div class="restore-modal-footer">
            <button type="button" class="restore-btn-cancel" id="restoreCancelBtn">Cancel</button>
            <button type="button" class="restore-btn-confirm" id="restoreConfirmBtn">Restore</button>
        </div>
    </div>
</div>

<script src="/js/restore-modal.js"></script>
