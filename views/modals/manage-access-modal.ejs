<!-- views/modals/manage-access-modal.ejs -->
<div class="manage-access-overlay" id="manageAccessModal" style="display: none;">
    <div class="manage-access-modal" style="position: relative; height: 600px !important; min-height: 600px !important; max-height: none !important; display: flex; flex-direction: column;">
        
        <button id="maCloseTopBtn" style="position: absolute; top: 15px; right: 15px; background-color: #d8b48e; border: none; border-radius: 6px; width: 30px; height: 30px; color: white; font-weight: bold; font-size: 18px; cursor: pointer; display: flex; align-items: center; justify-content: center;">&times;</button>

        <h3>Who has access</h3>
        <div class="ma-user-box" id="ma-user-box">
            <div style="display: flex; align-items: center; justify-content: space-between; width: 100%;">
                <div style="display: flex; align-items: center; gap: 10px;">
                    <svg id="ma-globe-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display: none;"><circle cx="12" cy="12" r="10"></circle><line x1="2" y1="12" x2="22" y2="12"></line><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg>
                    <svg id="ma-user-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display: none;"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle></svg>
                    <span id="ma-user-name">Anyone</span>
                </div>
                <i class="fas fa-chevron-down" id="ma-user-dropdown-icon" style="display: none; cursor: pointer; color: #5c634c;"></i>
            </div>
            <div id="ma-user-dropdown-list" style="display: none; flex-direction: column; gap: 4px; margin-top: 5px; border-top: 1px solid #798369; padding-top: 5px; padding-right: 8px; font-size: 16px; font-weight: normal; max-height: 55px; overflow-y: auto;">
                <!-- Names will be injected here -->
            </div>
        </div>

        <h3>What can they do</h3>
        <div class="ma-radio-group">
            <label class="ma-radio">
                <input type="radio" name="ma-permission" value="can view" checked>
                <span class="ma-radio-custom"></span> can view
            </label>
            <label class="ma-radio">
                <input type="radio" name="ma-permission" value="can edit">
                <span class="ma-radio-custom"></span> can edit
            </label>
            <label class="ma-radio">
                <input type="radio" name="ma-permission" value="can comment">
                <span class="ma-radio-custom"></span> can comment
            </label>
        </div>

        <h3>Shared Time</h3>
        <div class="ma-time-inputs">
            <input type="text" class="ma-time-input" id="ma-time-year"> year(s)
            <input type="text" class="ma-time-input" id="ma-time-month"> month(s)
            <input type="text" class="ma-time-input" id="ma-time-day"> day(s)
            <input type="text" class="ma-time-input" id="ma-time-hour"> hour(s)
            <input type="text" class="ma-time-input" id="ma-time-min"> minute(s)
        </div>
        <div class="ma-checkbox-group mt-10">
            <label class="ma-checkbox">
                <input type="checkbox" name="ma-time-forever" id="ma-time-forever" checked>
                <span class="ma-checkbox-custom"></span> Forever
            </label>
        </div>

        <h3>Additional security</h3>
        <div class="ma-checkbox-group" style="display: flex; flex-direction: column; gap: 10px;">
            <label class="ma-checkbox">
                <input type="checkbox" name="ma-password" id="ma-password-check">
                <span class="ma-checkbox-custom"></span> Password required
            </label>
            <div id="ma-password-container" style="display: none; position: relative; width: 250px; margin-left: 26px;">
                <input type="password" id="ma-password-input" class="ma-password-input" placeholder="Enter password">
                <i class="fas fa-eye" id="ma-password-toggle" style="position: absolute; right: 10px; top: 50%; transform: translateY(-50%); cursor: pointer; color: #3b4131;"></i>
            </div>
        </div>

        <div class="ma-footer" style="display: flex; justify-content: flex-end; gap: 15px; margin-top: auto; padding-top: 10px;">
            <button class="ma-cancel-btn" id="maCancelBtn">Cancel</button>
            <button class="ma-save-btn" id="maSaveBtn">Save</button>
        </div>
        
    </div>
</div>
