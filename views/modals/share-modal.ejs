<!-- views/modals/share-modal.ejs -->
<!-- Share Modal Overlay (ซ่อนไว้ก่อนด้วย style="display: none;" ถ้าจะให้แสดงเลยก็ลบออกครับ) -->
<div class="share-modal-overlay" id="shareModal" style="display: none;">
    <div class="share-modal">
        
        <!-- Header -->
        <div class="share-modal-header">
            <h2>Share this</h2>
            <div class="header-actions">
                <button class="copy-link-btn" id="copyLinkBtn">
                    <!-- SVG Link Icon -->
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg>
                    <span id="copyLinkText">copy link</span>
                </button>
                <button class="close-modal-btn" id="closeShareModalBtn">
                    ✖
                </button>
            </div>
        </div>

        <!-- Invite -->
        <div class="invite-section">
            <input type="text" class="invite-input" placeholder="Add people...">
            <button class="invite-btn" id="invite-btn">Invite</button>
        </div>

        <!-- Access List -->
        <div class="access-section">
            <h3>Who has access</h3>
            
            <!-- จุดนี้จะเป็น Container สำหรับให้ JavaScript โหลดรายชื่อเข้ามา -->
            <div id="dynamic-access-list">
                <!-- ข้อมูลจะถูก render โดย JS ใน share-modal.js -->
            </div>
        </div>

        <!-- Footer -->
        <div class="modal-footer">
            <button class="cancel-btn" id="cancelShareBtn">Cancel</button>
            <button class="save-btn">Save</button>
        </div>

    </div>
</div>