<!-- views/modals/delete-forever-modal.ejs -->
<link rel="stylesheet" href="/css/delete-forever-modal.css">

<div class="delete-forever-modal-overlay" id="deleteForeverModal" style="display: none;">
    <div class="delete-forever-modal" role="dialog" aria-modal="true" aria-labelledby="deleteForeverModalTitle">
        <h2 class="delete-forever-modal-title" id="deleteForeverModalTitle">Delete Forever</h2>
        <div class="delete-forever-modal-body">
            Are you sure you want to permanently delete <span class="delete-forever-filename-highlight" id="deleteForeverTargetName">this item</span>?
            <div class="delete-forever-warning">This action cannot be undone.</div>
        </div>
        <div class="delete-forever-modal-footer">
            <button type="button" class="delete-forever-btn-cancel" id="deleteForeverCancelBtn">Cancel</button>
            <button type="button" class="delete-forever-btn-confirm" id="deleteForeverConfirmBtn">Delete Forever</button>
        </div>
    </div>
</div>

<script src="/js/delete-forever-modal.js"></script>
