<style>
  /* ─── Top Bar (Admin) ─────────────────────────────────────── */
  .topbar-admin {
    width: 100%;
    height: 64px;
    background-color: #7d5534;
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 0 24px;
    position: sticky;
    top: 0;
    z-index: 200;
    box-shadow: 0 2px 6px rgba(0,0,0,0.25);
  }

  /* Logo section */
  .topbar-admin__logo {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
    text-decoration: none;
  }

  .topbar-admin__logo img {
    width: 40px;
    height: 40px;
    object-fit: contain;
  }

  .topbar-admin__logo-text {
    font-family: 'Outfit', sans-serif;
    font-size: 11px;
    font-weight: 700;
    color: #e8c9a0;
    letter-spacing: 2px;
    text-transform: uppercase;
    line-height: 1.2;
  }

  /* Search bar */
  .topbar-admin__search {
    flex: 1;
    position: relative;
    max-width: 480px;
  }

  .topbar-admin__search-icon {
    position: absolute;
    left: 12px;
    top: 50%;
    transform: translateY(-50%);
    color: #a07850;
    pointer-events: none;
  }

  .topbar-admin__search input {
    width: 100%;
    height: 38px;
    border-radius: 20px;
    border: none;
    background-color: #e8d5bb;
    padding: 0 16px 0 38px;
    font-family: 'Outfit', sans-serif;
    font-size: 13px;
    color: #4a2c14;
    outline: none;
    transition: box-shadow 0.2s;
  }

  .topbar-admin__search input::placeholder {
    color: #a07850;
  }

  .topbar-admin__search input:focus {
    box-shadow: 0 0 0 2px rgba(196, 154, 108, 0.5);
  }

  /* Spacer */
  .topbar-admin__spacer {
    flex: 1;
  }

  /* User info */
  .topbar-admin__user-info {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    flex-shrink: 0;
  }

  .topbar-admin__user-name {
    font-family: 'Outfit', sans-serif;
    font-size: 13px;
    font-weight: 600;
    color: #f5e6d3;
    white-space: nowrap;
  }

  .topbar-admin__datetime {
    font-family: 'Outfit', sans-serif;
    font-size: 11px;
    color: #c9a88a;
    white-space: nowrap;
  }

  /* Icon buttons group */
  .topbar-admin__icon-group {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-shrink: 0;
  }

  .topbar-admin__icon-btn {
    width: 36px;
    height: 36px;
    border-radius: 8px;
    border: 1.5px solid #c49a6c;
    background-color: transparent;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #f5e6d3;
    transition: background 0.2s, border-color 0.2s;
    text-decoration: none;
  }

  .topbar-admin__icon-btn:hover {
    background-color: rgba(255,255,255,0.1);
    border-color: #f5e6d3;
  }

  .topbar-admin__icon-btn svg {
    width: 18px;
    height: 18px;
    stroke: #f5e6d3;
  }
</style>

<header class="topbar-admin">
  <!-- Logo -->
  <a href="/drive" class="topbar-admin__logo" aria-label="Go to Home">
    <img src="/images/logo.png" alt="EasyDrive Logo" />
    <span class="topbar-admin__logo-text">Easy<br>Drive</span>
  </a>

  <!-- Search -->
  <div class="topbar-admin__search">
    <svg class="topbar-admin__search-icon" xmlns="http://www.w3.org/2000/svg"
         width="16" height="16" viewBox="0 0 24 24"
         fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="11" cy="11" r="8"/>
      <line x1="21" y1="21" x2="16.65" y2="16.65"/>
    </svg>
    <input type="text" placeholder="ค้นหา..." />
  </div>

  <!-- Spacer pushes user info to right -->
  <div class="topbar-admin__spacer"></div>

  <!-- User info -->
  <div class="topbar-admin__user-info">
    <span class="topbar-admin__user-name">Pacharanatthakorn Anan (Admin)</span>
    <span class="topbar-admin__datetime">08-08-2055 23:40:35</span>
  </div>

  <!-- Icon buttons -->
  <div class="topbar-admin__icon-group">
    <!-- Home -->
    <a href="/drive" class="topbar-admin__icon-btn" aria-label="Home">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
           fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
        <polyline points="9 22 9 12 15 12 15 22"/>
      </svg>
    </a>

    <!-- Settings -->
    <a href="/settings" class="topbar-admin__icon-btn" aria-label="Settings">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
           fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="3"/>
        <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06
                 a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09
                 A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83
                 l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09
                 A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83
                 l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09
                 a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83
                 l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09
                 a1.65 1.65 0 0 0-1.51 1z"/>
      </svg>
    </a>

    <!-- Admin / User Management -->
    <a href="/admin" class="topbar-admin__icon-btn" aria-label="User Management">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
           fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="2" y="3" width="20" height="14" rx="2" ry="2"/>
        <line x1="8" y1="21" x2="16" y2="21"/>
        <line x1="12" y1="17" x2="12" y2="21"/>
      </svg>
    </a>
  </div>
</header>

