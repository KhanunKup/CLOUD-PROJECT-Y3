<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Home Page — EasyDrive</title>
  <style>
    /* ── Reset & Base ────────────────────────────────────────── */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    @font-face {
      font-family: 'Outfit';
      src: url('/fonts/Outfit-VariableFont_wght.ttf') format('truetype');
    }
    @font-face {
      font-family: 'Kanit';
      src: url('/fonts/Kanit-Bold.ttf') format('truetype');
      font-weight: 700;
    }

    body {
      font-family: 'Outfit', sans-serif;
      background-color: #CEB59E;   /* Figma: page fill */
      min-height: 100vh;
      display: flex;
    }

    /* ── Layout ──────────────────────────────────────────────── */
    .page-layout {
      display: flex;
      width: 100%;
      min-height: 100vh;
    }

    /* Sidebar spacer (sidebar is position:fixed 160px) */
    .sidebar-spacer { width: 160px; flex-shrink: 0; }

    /* Main content */
    .main-content {
      flex: 1;
      display: flex;
      flex-direction: column;
      padding: 24px 32px;
      min-height: 100vh;
    }

    /* ── Search Bar — Figma: Rect35 #D9D9D9, w=957 h=80 ───── */
    .topbar {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 28px;
    }

    .search-wrapper {
      position: relative;
      flex: 1;
      max-width: 600px;
    }

    .search-icon {
      position: absolute;
      left: 14px;
      top: 50%;
      transform: translateY(-50%);
      color: #7a6251;
      pointer-events: none;
    }

    .search-input {
      width: 100%;
      height: 48px;
      border-radius: 28px;
      border: none;
      background-color: #D9D9D9;   /* Figma: Rectangle 35 */
      padding: 0 20px 0 44px;
      font-family: 'Outfit', sans-serif;
      font-size: 16px;
      color: #44362A;
      outline: none;
    }

    .search-input::placeholder { color: #888; }
    .search-input:focus { box-shadow: 0 0 0 2px #C4A071; }

    /* ── Page Title — Figma: MY DRIVE fill=#423E3B fs=70 ───── */
    .page-title {
      font-family: 'Outfit', sans-serif;
      font-size: 36px;
      font-weight: 700;
      color: #423E3B;              /* Figma title color */
      margin-bottom: 16px;
    }

    /* ── File Table Container — Figma: Rect52 #4E3E2E ─────── */
    .file-table-container {
      background-color: #4E3E2E;   /* Figma: Rectangle 52 */
      border-radius: 12px;
      overflow: hidden;
      flex: 1;
    }

    /* Table header */
    .file-table-header {
      display: grid;
      grid-template-columns: 1fr 160px 200px 56px;
      padding: 12px 24px;
      border-bottom: 1px solid rgba(245,242,235,0.2);
    }

    .file-table-header span {
      font-family: 'Outfit', sans-serif;
      font-size: 14px;
      font-weight: 600;
      color: #F5F2EB;              /* Figma: Name/Owner/Date text */
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    /* Table rows — Figma: Rect47 fill=#C4A071, text=#F6FAF2 */
    .file-row {
      display: grid;
      grid-template-columns: 1fr 160px 200px 56px;
      align-items: center;
      padding: 0 24px;
      height: 56px;
      background-color: #C4A071;   /* Figma: row fill */
      border-bottom: 2px solid #4E3E2E;
      transition: opacity 0.15s;
    }

    .file-row:last-child { border-bottom: none; }
    .file-row:hover { opacity: 0.88; }

    .file-name {
      display: flex;
      align-items: center;
      gap: 10px;
      font-family: 'Outfit', sans-serif;
      font-size: 14px;
      font-weight: 500;
      color: #F6FAF2;              /* Figma: Folder 1 text fill */
    }

    .file-name svg { color: #F6FAF2; flex-shrink: 0; }

    .file-owner {
      display: flex;
      align-items: center;
      gap: 6px;
      font-family: 'Outfit', sans-serif;
      font-size: 14px;
      color: #F6FAF2;
    }

    .owner-avatar {
      width: 22px;
      height: 22px;
      border-radius: 50%;
      background-color: #7d5534;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .owner-avatar svg { color: #F6FAF2; }

    .file-date {
      font-family: 'Outfit', sans-serif;
      font-size: 13px;
      color: #F6FAF2;
    }

    .file-options {
      display: flex;
      justify-content: flex-end;
    }

    .file-options-btn {
      background: none;
      border: none;
      cursor: pointer;
      padding: 6px;
      color: #F6FAF2;
      border-radius: 6px;
      transition: background 0.15s;
    }

    .file-options-btn:hover { background: rgba(255,255,255,0.15); }

    /* ── New Button — Figma: Rect46 fill=#525A40 w=200 h=80 ── */
    .btn-new {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 10px 22px;
      background-color: #525A40;   /* Figma: Rectangle 46 */
      color: #F6FAF2;
      border: none;
      border-radius: 10px;
      font-family: 'Outfit', sans-serif;
      font-size: 15px;
      font-weight: 600;
      cursor: pointer;
      transition: background 0.2s;
      text-decoration: none;
      margin-left: auto;
    }

    .btn-new:hover { background-color: #3f4730; }

    .btn-new .plus { font-size: 20px; font-weight: 400; line-height: 1; }

    /* Title row with button */
    .title-row {
      display: flex;
      align-items: center;
      margin-bottom: 12px;
    }

    /* Empty state */
    .empty-state {
      padding: 60px 24px;
      text-align: center;
      color: #E8E2D6;
      font-size: 14px;
    }
  </style>
</head>
<body>
<div class="page-layout">

  <!-- Sidebar partial -->
  <%- include('../partials/nav/sidebar', { currentPage: 'home', user: typeof user !== 'undefined' ? user : null }) %>
  <div class="sidebar-spacer"></div>

  <!-- Main content -->
  <main class="main-content">

    <!-- Search + New button row -->
    <div class="topbar">
      <div class="search-wrapper">
        <svg class="search-icon" width="18" height="18" viewBox="0 0 24 24"
             fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
        <input class="search-input" type="text" placeholder="Search in Drive" />
      </div>
      <a href="/upload" class="btn-new">
        <span class="plus">+</span> New
      </a>
    </div>

    <!-- Title -->
    <div class="title-row">
      <h1 class="page-title">MY DRIVE</h1>
    </div>

    <!-- File Table -->
    <div class="file-table-container">
      <div class="file-table-header">
        <span>Name</span>
        <span>Owner</span>
        <span>Date Uploaded</span>
        <span></span>
      </div>

      <% if (typeof files !== 'undefined' && files && files.length > 0) { %>
        <% files.forEach(function(file) { %>
        <div class="file-row">
          <!-- Name -->
          <div class="file-name">
            <% if (file.type === 'folder') { %>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                   stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/>
              </svg>
            <% } else { %>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                   stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                <polyline points="14 2 14 8 20 8"/>
              </svg>
            <% } %>
            <%= file.name %>
          </div>
          <!-- Owner -->
          <div class="file-owner">
            <div class="owner-avatar">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none"
                   stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                <circle cx="12" cy="7" r="4"/>
              </svg>
            </div>
            <%= file.owner || 'me' %>
          </div>
          <!-- Date -->
          <div class="file-date"><%= file.uploadedAt || '—' %></div>
          <!-- Options -->
          <div class="file-options">
            <button class="file-options-btn" aria-label="Options">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                   stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="5" r="1"/><circle cx="12" cy="12" r="1"/>
                <circle cx="12" cy="19" r="1"/>
              </svg>
            </button>
          </div>
        </div>
        <% }); %>
      <% } else { %>
        <div class="empty-state">No files yet. Click <strong>+ New</strong> to upload.</div>
      <% } %>
    </div>

  </main>
</div>
</body>
</html>

