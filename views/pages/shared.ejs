<!-- views/pages/shared.ejs -->
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Shared With Me - EASYDRIVE</title>
    
    <!-- FontAwesome สำหรับไอคอน (อิงตามที่เพื่อนทำใน homepage) -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    
    <!-- CSS สำหรับ Modal ที่เราแยกไว้ -->
    <link rel="stylesheet" href="/css/share-modal.css">
    <!-- CSS สำหรับ Menu Dropdown -->
    <link rel="stylesheet" href="/css/menu.css">
    
<link rel="stylesheet" href="/css/homepage.css">
</head>
<body>

    <!-- ดึง Sidebar ของเพื่อนมาใช้เลย -->
    <%- include('../partials/nav/sidebar') %>

    <!-- Main Content -->
    <div class="main-content">
        
        <!-- Search Bar -->
        <div class="search-container">
            <i class="fas fa-search"></i>
            <input type="text" placeholder="Search in Drive">
        </div>

        <!-- Header -->
        <div class="page-header">
            <h1>SHARED WITH ME</h1>
            <button class="btn-new">+ New</button>
        </div>

        <!-- File List -->
        <div class="file-container">
            <!-- หัวตาราง -->
            <div class="file-header">
                <span>Name</span>
                <span>Owner</span>
                <span>Date Uploaded</span>
                <span></span>
            </div>
            <hr class="file-header-divider">

            <!-- รายการไฟล์จาก Backend -->
            <% if (typeof files !== 'undefined' && files.length > 0) { %>
                <% files.forEach(file => { %>
                    <div class="file-row">
                        <span class="col-name">
                            <i class="<%= file.type === 'folder' ? 'fas fa-folder' : (file.name.endsWith('.png') || file.name.endsWith('.jpg') ? 'fas fa-image' : 'fas fa-file-alt') %>"></i> 
                            <%= file.name %>
                        </span>
                        <span class="col-owner"><i class="far fa-user-circle"></i> <%= file.owner || 'me' %></span>
                        <span class="col-date"><%= file.uploadDate %></span>
                        
                        <div class="options-wrapper">
                            <button class="options-btn toggle-options"><i class="fas fa-ellipsis-h"></i></button>
                            <%- include(file.type === 'folder' ? '../menus/folder-option-menu' : '../menus/file-option-menu') %>
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <p style="text-align: center; margin-top: 20px;">No shared files found.</p>
            <% } %>
            
        </div>
    </div>

    <!-- ดึง Share Modal มาใช้ตรงนี้ -->
    <%- include('../modals/share-modal') %>

    <!-- เรียกใช้ JS ของ Modal -->
    <script src="/js/share-modal.js"></script>
    
    <!-- เรียกใช้ JS ของ Menu Dropdown -->
    <script src="/js/menu.js"></script>
</body>
</html>
