<!-- views/pages/shared.ejs -->
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Shared With Me - EASYDRIVE</title>
    
    <!-- FontAwesome สำหรับไอคอน (อิงตามที่เพื่อนทำใน homepage) -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    
    <!-- CSS สำหรับ Modal ที่เราแยกไว้ -->
    <link rel="stylesheet" href="/css/share-modal.css">
    <!-- CSS สำหรับ Menu Dropdown -->
    <link rel="stylesheet" href="/css/menu.css">
    
    <!-- โครงสร้าง CSS ที่อิงตามของเพื่อน (homepage.ejs) -->
    <style>
        @font-face {
            font-family: 'EnglishFont';
            src: url('/fonts/Kanit-Bold.ttf') format('truetype'); 
        }

        @font-face {
            font-family: 'ThaiFont';
            src: url('/fonts/Outfit-VariableFont_wght.ttf') format('truetype'); 
        }

        body {
            margin: 0;
            font-family: 'EnglishFont', 'ThaiFont', sans-serif;
            background-color: #d6bead; /* สีจากเพื่อน */
            display: flex;
            height: 100vh;
        }

        .main-content {
            margin-left: 160px; /* เว้นที่ให้ Sidebar ของเพื่อน */
            flex: 1;
            padding: 40px;
            display: flex;
            flex-direction: column;
            box-sizing: border-box;
        }

        /* Search Bar (อิงจากของเพื่อน) */
        .search-container {
            background-color: #e8dbce;
            border-radius: 25px;
            padding: 10px 20px;
            display: flex;
            align-items: center;
            width: 60%;
            margin-bottom: 40px;
        }
        
        .search-container i {
            color: #4a4a4a;
            margin-right: 15px;
            font-size: 1.2rem;
        }

        .search-container input {
            border: none;
            background: transparent;
            outline: none;
            font-size: 1rem;
            width: 100%;
            color: #4a4a4a;
            font-weight: bold;
            font-family: 'EnglishFont', 'ThaiFont', sans-serif;
        }

        /* Header Area */
        .page-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }

        .page-header h1 {
            color: #4a4a4a;
            font-size: 2.5rem;
            font-weight: 900;
            margin: 0;
        }

        .btn-new {
            background-color: #556b4d; /* สีจากเพื่อน */
            color: white;
            border: none;
            padding: 10px 25px;
            border-radius: 8px;
            font-size: 1.1rem;
            font-weight: bold;
            cursor: pointer;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
            font-family: 'EnglishFont', 'ThaiFont', sans-serif;
        }

        .btn-new:hover {
            background-color: #485a41;
        }

        /* File List Box (อิงจากของเพื่อน) */
        .file-container {
            background-color: #634f41;
            border-radius: 15px;
            padding: 25px 30px;
            color: white;
            flex: 1;
        }

        .file-header {
            display: grid;
            grid-template-columns: 2fr 1fr 1fr auto;
            font-weight: bold;
            font-size: 1.1rem;
            margin-bottom: 15px;
            padding: 0 15px;
        }

        .file-header-divider {
            border: 0;
            height: 1px;
            background-color: rgba(255,255,255,0.3);
            margin-bottom: 20px;
        }

        .file-row {
            background-color: #c89f78;
            border-radius: 8px;
            display: grid;
            grid-template-columns: 2fr 1fr 1fr auto;
            align-items: center;
            padding: 15px;
            margin-bottom: 12px;
            font-weight: bold;
        }

        .file-row:last-child {
            margin-bottom: 0;
        }

        .col-name {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .col-owner {
            display: flex;
            align-items: center;
            gap: 8px;
            font-weight: normal;
        }

        .col-date {
            font-weight: normal;
        }

        .options-btn {
            background: none;
            border: none;
            font-size: 1.2rem;
            cursor: pointer;
            color: white; 
            padding: 0 10px;
        }
    </style>
</head>
<body>

    <!-- ดึง Sidebar ของเพื่อนมาใช้เลย -->
    <%- include('../partials/nav/sidebar') %>

    <!-- Main Content -->
    <div class="main-content">
        
        <!-- Search Bar -->
        <div class="search-container">
            <i class="fas fa-search"></i>
            <input type="text" placeholder="Search in Drive">
        </div>

        <!-- Header -->
        <div class="page-header">
            <h1>SHARED WITH ME</h1>
            <button class="btn-new">+ New</button>
        </div>

        <!-- File List -->
        <div class="file-container">
            <!-- หัวตาราง -->
            <div class="file-header">
                <span>Name</span>
                <span>Owner</span>
                <span>Date Uploaded</span>
                <span></span>
            </div>
            <hr class="file-header-divider">

            <!-- รายการไฟล์จาก Backend -->
            <% if (typeof files !== 'undefined' && files.length > 0) { %>
                <% files.forEach(file => { %>
                    <div class="file-row">
                        <span class="col-name">
                            <i class="<%= file.type === 'folder' ? 'fas fa-folder' : (file.name.endsWith('.png') || file.name.endsWith('.jpg') ? 'fas fa-image' : 'fas fa-file-alt') %>"></i> 
                            <%= file.name %>
                        </span>
                        <span class="col-owner"><i class="far fa-user-circle"></i> <%= file.owner || 'me' %></span>
                        <span class="col-date"><%= file.uploadDate %></span>
                        
                        <div class="options-wrapper">
                            <button class="options-btn toggle-options"><i class="fas fa-ellipsis-h"></i></button>
                            <%- include(file.type === 'folder' ? '../menus/folder-option-menu' : '../menus/file-option-menu') %>
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <p style="text-align: center; margin-top: 20px;">No shared files found.</p>
            <% } %>
            
        </div>
    </div>

    <!-- ดึง Share Modal มาใช้ตรงนี้ -->
    <%- include('../modals/share-modal') %>

    <!-- เรียกใช้ JS ของ Modal -->
    <script src="/js/share-modal.js"></script>
    
    <!-- เรียกใช้ JS ของ Menu Dropdown -->
    <script src="/js/menu.js"></script>
</body>
</html>
