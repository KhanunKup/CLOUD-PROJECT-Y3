<!-- แนะนำให้เรียกใช้ FontAwesome ใน <head> ของหน้าหลัก เพื่อให้แสดงไอคอนได้ -->
<!-- <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css"> -->
<link rel="stylesheet" href="/css/homepage.css">

<div class="nav">
    <%- include('../partials/nav/sidebar.ejs') %>
</div>

<div class="main-content">
  
  <!-- Search Bar -->
  <div class="search-container">
    <i class="fas fa-search"></i>
    <input type="text" placeholder="Search in Drive">
  </div>

  <!-- Header -->
  <div class="page-header">
    <h1>MY DRIVE ขนุนลูกโตๆ</h1>
    <button class="btn-new">+ New</button>
  </div>

  <!-- File List Container -->
  <div class="file-container">
    <div class="file-header">
      <span>Name</span>
      <span>Owner</span>
      <span>Date Uploaded</span>
      <span></span>
    </div>
    <hr class="file-header-divider">

    <!-- เริ่มการวนลูป EJS สำหรับแสดงรายการไฟล์ -->
    <% if (typeof files !== 'undefined' && files.length > 0) { %>
      <% files.forEach(file => { %>
        <div class="file-row">
          <span class="col-name">
            <!-- เช็คประเภทไฟล์เพื่อแสดงไอคอนที่ต่างกัน (ปรับแก้ตามข้อมูลจริงได้) -->
            <i class="<%= file.type === 'folder' ? 'fas fa-folder' : 'fas fa-file' %>"></i> 
            <%= file.name %>
          </span>
          <span class="col-owner">
            <i class="far fa-user-circle"></i> <%= file.owner || 'me' %>
          </span>
          <span class="col-date"><%= file.uploadDate %></span>
          <span class="col-action"><i class="fas fa-ellipsis-h"></i></span>
        </div>
      <% }) %>
    <% } else { %>
      <!-- โค้ดส่วนนี้คือข้อมูลจำลอง (Mockup) ตามภาพ ในกรณีที่ยังไม่ได้ต่อ Backend -->
      <div class="file-row">
        <span class="col-name">Folder 1</span>
        <span class="col-owner"><i class="far fa-user-circle"></i> me</span>
        <span class="col-date">08 Aug. 2008</span>
        <span class="col-action"><i class="fas fa-ellipsis-h"></i></span>
      </div>
      <div class="file-row">
        <span class="col-name">File1.txt</span>
        <span class="col-owner"><i class="far fa-user-circle"></i> me</span>
        <span class="col-date">08 Aug. 2008</span>
        <span class="col-action"><i class="fas fa-ellipsis-h"></i></span>
      </div>
      <div class="file-row">
        <span class="col-name">Image1.png</span>
        <span class="col-owner"><i class="far fa-user-circle"></i> me</span>
        <span class="col-date">08 Aug. 2008</span>
        <span class="col-action"><i class="fas fa-ellipsis-h"></i></span>
      </div>
      <div class="file-row">
        <span class="col-name">Folder 2</span>
        <span class="col-owner"><i class="far fa-user-circle"></i> me</span>
        <span class="col-date">08 Aug. 2008</span>
        <span class="col-action"><i class="fas fa-ellipsis-h"></i></span>
      </div>
      <div class="file-row">
        <span class="col-name">Image2.jpg</span>
        <span class="col-owner"><i class="far fa-user-circle"></i> me</span>
        <span class="col-date">08 Aug. 2008</span>
        <span class="col-action"><i class="fas fa-ellipsis-h"></i></span>
      </div>
      <div class="file-row">
        <span class="col-name">File3.sh</span>
        <span class="col-owner"><i class="far fa-user-circle"></i> me</span>
        <span class="col-date">08 Aug. 2008</span>
        <span class="col-action"><i class="fas fa-ellipsis-h"></i></span>
      </div>
    <% } %>
    
  </div>
</div>
