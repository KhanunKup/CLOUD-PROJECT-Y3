<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>EasyDrive - Sign Up</title>

    <link rel="stylesheet" href="css/signup.css">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;500;600&family=Outfit:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>

<body>

    <div class="page">

        <div class="signup-container">

            <!-- =========================
                 LEFT : FORM
            ========================== -->
            <section class="form-side">

                <div class="form-box">

                    <h1>Sign Up</h1>

                    <p class="subtitle">
                        เข้าสู่ระบบจัดเก็บและแบ่งปันไฟล์
                    </p>


                    <!-- Username -->
                    <div class="input-box">

                        <div class="icon">
                            <svg viewBox="0 0 24 24">
                                <circle cx="12" cy="8" r="4"></circle>
                                <path d="M4 20c0-4 3.5-6 8-6s8 2 8 6"></path>
                            </svg>
                        </div>

                        <input
                            type="text"
                            placeholder="กรุณากรอกชื่อผู้ใช้"
                        >

                    </div>


                    <!-- Password -->
                    <div class="input-box">

                        <div class="icon">
                            <svg viewBox="0 0 24 24">
                                <rect x="5" y="10" width="14" height="10" rx="2"></rect>
                                <path d="M8 10V7a4 4 0 0 1 8 0v3"></path>
                            </svg>
                        </div>

                        <input
                            type="password"
                            placeholder="กรุณากรอกรหัสผ่าน"
                        >

                    </div>


                    <!-- Confirm Password -->
                    <div class="input-box">

                        <div class="icon">
                            <svg viewBox="0 0 24 24">
                                <path d="M12 3L20 7V11C20 16 16.5 20 12 21C7.5 20 4 16 4 11V7L12 3Z"></path>
                                <path d="M9 12l2 2 4-4"></path>
                            </svg>
                        </div>

                        <input
                            type="password"
                            placeholder="กรุณากรอกรหัสผ่านอีกครั้ง"
                        >

                    </div>


                    <!-- Password Requirements -->
                    <div class="password-rules">

                        <div class="rule">
                            <span class="check">✓</span>
                            Password must contain at least 8 characters
                        </div>

                        <div class="rule">
                            <span class="check">✓</span>
                            Password must contain an uppercase & lowercase letter
                        </div>

                        <div class="rule">
                            <span class="check">✓</span>
                            Password must contain a number & symbols
                        </div>

                    </div>


                    <!-- Sign in -->
                    <div class="login-text">
                        Already have an account?
                        <a href="#">Sign in here</a>
                    </div>


                    <!-- Button -->
                    <button class="signup-btn">
                        <span>Sign Up</span>

                        <span class="arrow">
                            →
                        </span>
                    </button>

                </div>

            </section>


            <!-- =========================
                 RIGHT : VISUAL
            ========================== -->
            <section class="visual-side">

                <!-- Background illustration -->
                <img
                    src="images/easydrive-bg.png"
                    class="visual-bg"
                    alt=""
                >


                <div class="visual-content">

                    <img
                        src="images/easydrive-logo.png"
                        class="logo"
                        alt="EasyDrive"
                    >

                    <p>
                        Simple. Secure. Easy.
                    </p>

                    <div class="visual-badge">
                        <span class="badge-dot"></span>
                        Your files, everywhere.
                    </div>

                </div>

            </section>

        </div>

    </div>

</body>
</html>