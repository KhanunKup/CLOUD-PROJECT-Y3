# ==========================================
# EasyDrive Root Environment Template
# ==========================================
# Copy this file to backend/.env for local running
# Values can be retrieved from: cd infrastructure && terraform output

PORT=3000
NODE_ENV=development
USE_MOCK=false
SESSION_SECRET=your-random-32-char-secret-key-here

# AWS Infrastructure (Terraform Provisioned)
AWS_REGION=us-east-1
STORAGE_BUCKET=easydrive-itkmitl-storage
FILES_TABLE=easydrive-files
SHARES_TABLE=easydrive-shares
USERS_TABLE=easydrive-users
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:easydrive-download-alerts

# AWS Credentials (AWS Academy Learner Lab or IAM User)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
