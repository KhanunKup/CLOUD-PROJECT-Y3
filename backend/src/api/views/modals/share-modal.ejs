<!-- views/modals/share-modal.ejs -->
<link rel="stylesheet" href="/css/share-modal.css">

<!-- Share Modal Overlay (ซ่อนไว้ก่อนด้วย style="display: none;" ถ้าจะให้แสดงเลยก็ลบออกครับ) -->
<div class="share-modal-overlay" id="shareModal" style="display: none;">
    <div class="share-modal">
        <input type="hidden" id="shareModeInput" value="create">
        <input type="hidden" id="shareIdInput" value="">
        
        <!-- Header -->
        <div class="share-modal-header">
            <div>
                <h2 id="shareModalTitle">Share this</h2>
                <div id="shareModalFileName" style="font-size: 13px; color: #e8e2d6; margin-top: 4px; font-weight: 500;"></div>
            </div>
            <div class="header-actions">
                <button class="copy-link-btn" id="copyLinkBtn">
                    <!-- SVG Link Icon -->
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg>
                    <span id="copyLinkText">copy link</span>
                </button>
                <button class="close-modal-btn" id="closeShareModalBtn">
                    ✖
                </button>
            </div>
        </div>

        <!-- Public Link & Security Settings -->
        <div class="share-security-section" style="background: rgba(0,0,0,0.12); padding: 14px 18px; border-radius: 10px; margin-bottom: 22px;">
            <div style="font-weight: 700; color: #fff; margin-bottom: 12px; font-size: 15px; display: flex; align-items: center; justify-content: space-between;">
                <span style="display: flex; align-items: center; gap: 8px;">
                    <i class="fas fa-shield-alt"></i> Public Link &amp; Access Control
                </span>
                <span id="shareStatusBadge" style="font-size: 12px; font-weight: normal; color: #e2e2e2;"></span>
            </div>
            
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 12px;">
                <div>
                    <label style="display: block; font-size: 13px; color: #e2e2e2; margin-bottom: 5px; font-weight: 500;">
                        <i class="fas fa-clock"></i> Expiration (TTL)
                    </label>
                    <select id="shareExpireHours" style="width: 100%; background: #e2e2e2; border: none; border-radius: 6px; padding: 8px 10px; font-size: 14px; color: #333; outline: none; font-weight: 500;">
                        <option value="1">1 hour</option>
                        <option value="24" selected>24 hours (1 day)</option>
                        <option value="168">7 days</option>
                        <option value="720">30 days</option>
                    </select>
                </div>
                <div>
                    <label style="display: block; font-size: 13px; color: #e2e2e2; margin-bottom: 5px; font-weight: 500;">
                        <i class="fas fa-fire"></i> Download Limit
                    </label>
                    <select id="shareMaxDownloads" style="width: 100%; background: #e2e2e2; border: none; border-radius: 6px; padding: 8px 10px; font-size: 14px; color: #333; outline: none; font-weight: 500;">
                        <option value="0" selected>Unlimited</option>
                        <option value="1">1 download (Burn-After-Read)</option>
                        <option value="5">5 downloads</option>
                        <option value="10">10 downloads</option>
                    </select>
                </div>
            </div>

            <div style="margin-bottom: 12px;">
                <label style="display: block; font-size: 13px; color: #e2e2e2; margin-bottom: 5px; font-weight: 500;">
                    <i class="fas fa-lock"></i> Passcode Protection (Optional)
                </label>
                <input type="password" id="sharePassword" placeholder="Leave empty for public link" style="width: 100%; background: #e2e2e2; border: none; border-radius: 6px; padding: 8px 12px; font-size: 14px; color: #333; outline: none; box-sizing: border-box;">
                <div id="sharePasswordCurrentNotice" style="display: none; font-size: 12px; color: #e8f0fe; margin-top: 6px; align-items: center; gap: 8px;">
                    <span>🔒 Current link is password-protected.</span>
                    <label style="cursor: pointer; display: inline-flex; align-items: center; gap: 4px; color: #ffb4b4; font-weight: 600;">
                        <input type="checkbox" id="shareRemovePasswordCheckbox"> Remove password
                    </label>
                </div>
            </div>

            <div style="display: flex; gap: 10px; align-items: center; margin-top: 8px;">
                <button type="button" id="createShareLinkBtn" style="flex: 1; background: #555e46; color: white; border: none; border-radius: 8px; padding: 10px; font-weight: 700; font-size: 14px; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 8px; transition: background 0.2s;">
                    <i class="fas fa-link" id="createShareLinkIcon"></i> <span id="createShareLinkText">Create &amp; Copy Share Link</span>
                </button>
                <button type="button" id="modalStopShareBtn" style="display: none; background: #a83232; color: white; border: none; border-radius: 8px; padding: 10px 14px; font-weight: 700; font-size: 14px; cursor: pointer; align-items: center; justify-content: center; gap: 6px; transition: background 0.2s;" title="Stop sharing and revoke link">
                    <i class="fas fa-link-slash"></i> <span>Stop Sharing</span>
                </button>
            </div>
            <div id="shareLinkResultBox" style="display: none; margin-top: 10px; background: rgba(0,0,0,0.2); border-radius: 6px; padding: 8px 12px; font-size: 13px; color: #fff; word-break: break-all;">
                <span style="color: #d1d5c9;">Share URL: </span><a id="shareGeneratedLink" href="#" target="_blank" style="color: #fff; font-weight: 600; text-decoration: underline;"></a>
            </div>
        </div>

        <!-- Invite -->
        <div class="invite-section">
            <div class="invite-input-container">
                <input type="text" class="invite-input" id="invite-input" placeholder="Add comma separated emails to invite">
                <select class="invite-permission-dropdown" id="invite-permission" style="display: none;">
                    <option value="can view">can view</option>
                    <option value="can edit">can edit</option>
                    <option value="can comment">can comment</option>
                </select>
            </div>
            <button class="invite-btn" id="invite-btn">Invite</button>
        </div>

        <!-- Access List -->
        <div class="access-section">
            <h3>Who has access</h3>
            
            <!-- จุดนี้จะเป็น Container สำหรับให้ JavaScript โหลดรายชื่อเข้ามา -->
            <div id="dynamic-access-list">
                <!-- ข้อมูลจะถูก render โดย JS ใน share-modal.js -->
            </div>
        </div>

        <!-- Footer -->
        <div class="modal-footer share-modal-footer">
            <button class="cancel-btn" id="cancelShareBtn">Cancel</button>
            <button class="save-btn" id="saveChangesBtn">Save</button>
        </div>

    </div>
</div>

<script src="/js/share-modal.js"></script>