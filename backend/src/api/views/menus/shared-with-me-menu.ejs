<!-- views/menus/shared-with-me-menu.ejs -->
<div class="options-dropdown file-options">
    <button class="option-item open-preview-modal" 
            data-id="<%= typeof file !== 'undefined' && (file.id || file.file_id) ? (file.id || file.file_id) : '' %>" 
            data-filename="<%= typeof file !== 'undefined' && (file.name || file.filename) ? (file.name || file.filename) : '' %>"
            data-category="<%= typeof file !== 'undefined' && file.category ? file.category : '' %>">
        <i class="fas fa-eye"></i> Preview
    </button>
    <button class="option-item download-action" data-id="<%= typeof file !== 'undefined' && (file.id || file.file_id) ? (file.id || file.file_id) : '' %>" data-filename="<%= typeof file !== 'undefined' && file.name ? file.name : '' %>"><i class="fas fa-download"></i> <span class="download-text">Download</span></button>
    <% if (typeof file !== 'undefined' && (file.permission === 'can edit' || file.canEdit)) { %>
    <button class="option-item open-rename-modal" data-id="<%= typeof file !== 'undefined' && (file.id || file.file_id) ? (file.id || file.file_id) : '' %>" data-filename="<%= typeof file !== 'undefined' && (file.name || file.filename) ? (file.name || file.filename) : '' %>"><i class="fas fa-pencil-alt"></i> Rename</button>
    <% } %>
    <button class="option-item copy-share-link-btn" data-url="<%= typeof file !== 'undefined' && file.shareUrl ? file.shareUrl : '' %>"><i class="fas fa-link"></i> <span class="copy-link-text">Copy link</span></button>
    <button class="option-item show-share-info-btn open-info-drawer" data-id="<%= typeof file !== 'undefined' && (file.id || file.file_id) ? (file.id || file.file_id) : '' %>" data-filename="<%= typeof file !== 'undefined' && (file.name || file.filename) ? (file.name || file.filename) : '' %>" data-type="file" data-category="<%= typeof file !== 'undefined' && file.category ? file.category : '' %>" data-file="<%= encodeURIComponent(JSON.stringify(typeof file !== 'undefined' ? file : {})) %>"><i class="fas fa-info-circle"></i> Information</button>
</div>
