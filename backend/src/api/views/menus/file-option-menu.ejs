<!-- views/menus/file-menu.ejs -->
<div class="options-dropdown file-options">
    <button class="option-item"><i class="fas fa-eye"></i> Preview</button>
    <button class="option-item download-action" data-id="<%= typeof file !== 'undefined' && (file.id || file.file_id) ? (file.id || file.file_id) : '' %>" data-filename="<%= typeof file !== 'undefined' && file.name ? file.name : '' %>"><i class="fas fa-download"></i> <span class="download-text">Download</span></button>
    <button class="option-item open-rename-modal" data-id="<%= typeof file !== 'undefined' && (file.id || file.file_id) ? (file.id || file.file_id) : '' %>" data-filename="<%= typeof file !== 'undefined' && file.name ? file.name : '' %>"><i class="fas fa-pencil-alt"></i> Rename</button>
    <button class="option-item open-tags-modal" 
            data-id="<%= typeof file !== 'undefined' && (file.id || file.file_id) ? (file.id || file.file_id) : '' %>" 
            data-filename="<%= typeof file !== 'undefined' && file.name ? file.name : '' %>"
            data-tags="<%= typeof file !== 'undefined' && file.tags ? (Array.isArray(file.tags) ? file.tags.join(',') : file.tags) : '' %>">
        <i class="fas fa-tags"></i> Edit Tags
    </button>
    <button class="option-item copy-link-action" data-id="<%= typeof file !== 'undefined' && (file.id || file.file_id) ? (file.id || file.file_id) : '' %>" data-filename="<%= typeof file !== 'undefined' && file.name ? file.name : '' %>"><i class="fas fa-link"></i> <span class="copy-link-text">Copy link</span></button>
    <% if (typeof file !== 'undefined' && file.isShared) { %>
        <button class="option-item open-share-modal" 
                data-id="<%= file.id || file.file_id || '' %>" 
                data-share-id="<%= file.shareId || '' %>"
                data-filename="<%= file.name || '' %>" 
                data-mode="edit"
                data-expire-hours="<%= file.shareExpireHours || '24' %>"
                data-max-downloads="<%= file.shareMaxDownloads !== undefined ? file.shareMaxDownloads : '0' %>"
                data-has-password="<%= file.hasPassword ? 'true' : 'false' %>"
                data-share-url="<%= file.shareUrl || '' %>"
                data-access="<%= encodeURIComponent(JSON.stringify(file.accessList || [])) %>">
            <i class="fas fa-sliders-h"></i> Edit Share
        </button>
        <button class="option-item stop-sharing-action" 
                style="color: #d32f2f;"
                data-share-id="<%= file.shareId || '' %>" 
                data-file-id="<%= file.id || file.file_id || '' %>" 
                data-filename="<%= file.name || '' %>">
            <i class="fas fa-link-slash"></i> Stop Sharing
        </button>
    <% } else { %>
        <button class="option-item open-share-modal" 
                data-id="<%= typeof file !== 'undefined' && (file.id || file.file_id) ? (file.id || file.file_id) : '' %>" 
                data-filename="<%= typeof file !== 'undefined' && file.name ? file.name : '' %>" 
                data-mode="create"
                data-access="<%= encodeURIComponent(JSON.stringify(typeof file !== 'undefined' && file.accessList ? file.accessList : [])) %>">
            <i class="fas fa-share"></i> Share
        </button>
    <% } %>
    <button class="option-item"><i class="fas fa-info-circle"></i> Information</button>
    <button class="option-item open-delete-modal move-to-trash-action" data-filename="<%= typeof file !== 'undefined' && file.name ? file.name : '' %>" data-id="<%= typeof file !== 'undefined' && (file.id || file.file_id) ? (file.id || file.file_id) : '' %>"><i class="fas fa-trash-alt"></i> <span class="move-to-trash-text">Move to Trash</span></button>
</div>
