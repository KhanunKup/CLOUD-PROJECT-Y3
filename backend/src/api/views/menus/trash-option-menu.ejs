<!-- views/menus/trash-option-menu.ejs -->
<div class="options-dropdown trash-options">
    <button class="option-item restore-trash-action" data-id="<%= typeof file !== 'undefined' && (file._id || file.id) ? (file._id || file.id) : '' %>" data-filename="<%= typeof file !== 'undefined' && file.name ? file.name : '' %>">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3.5 17.5L2 14h4"/>
            <path d="M2.5 14A9 9 0 1 1 5 19"/>
            <polyline points="12 7 12 12 15 12"/>
        </svg>
        <span>Restore</span>
    </button>
    <button class="option-item delete-forever-action" data-id="<%= typeof file !== 'undefined' && (file._id || file.id) ? (file._id || file.id) : '' %>" data-filename="<%= typeof file !== 'undefined' && file.name ? file.name : '' %>">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="4" width="18" height="3" rx="1.5"/>
            <path d="M5 7l1.5 13a2 2 0 0 0 2 2h7a2 2 0 0 0 2-2L19 7"/>
            <rect x="9" y="11.5" width="6" height="6" rx="0.5"/>
            <line x1="9" y1="11.5" x2="15" y2="17.5"/>
            <line x1="15" y1="11.5" x2="9" y2="17.5"/>
        </svg>
        <span>Delete Forever</span>
    </button>
</div>
