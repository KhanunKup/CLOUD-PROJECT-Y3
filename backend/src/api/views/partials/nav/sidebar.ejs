<%# PARTIAL: sidebar.ejs | Usage: include('../partials/nav/sidebar', { currentPage: 'home|shared|trash' }) %>

<style>
  /* ─── Sidebar Nav (pixel-perfect from Figma) ──────────────── */
  /* Figma: Sidebar BG = #846145, width=370px, height=1085px */

  .sidebar {
    width: 160px;                   /* scaled from 370 Figma units */
    min-height: 100vh;
    background-color: #846145;      /* Figma: Rectangle 29 fill */
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 20px 0 0 0;
    position: fixed;
    top: 0;
    left: 0;
    bottom: 0;
    z-index: 100;
    box-shadow: 2px 0 8px rgba(0,0,0,0.18);
  }

  /* Logo area */
  .sidebar-logo {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom: 28px;
    gap: 6px;
    text-decoration: none;
  }

  .sidebar-logo svg {
    width: 52px;
    height: 52px;
  }

  .sidebar-logo-text {
    font-family: 'Outfit', sans-serif;
    font-size: 10px;
    font-weight: 700;
    color: #E8E2D6;               /* Figma: SHARED text color */
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  /* Nav items group */
  .sidebar-nav {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 0 10px;
  }

  .sidebar-nav-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 11px 12px;
    border-radius: 10px;
    cursor: pointer;
    text-decoration: none;
    transition: background 0.18s;
    position: relative;
  }

  .sidebar-nav-item:hover {
    background-color: rgba(0,0,0,0.15);
  }

  /* Active state — MY DRIVE: Figma shows Rectangle 30 (dark bg) + polygon arrow */
  .sidebar-nav-item.active {
    background-color: #44362A;    /* Figma: MY DRIVE text fill (dark brown) */
  }

  .sidebar-nav-item .nav-label {
    font-family: 'Outfit', sans-serif;
    font-size: 11px;
    font-weight: 700;
    color: #E8E2D6;              /* Figma: SHARED text color */
    letter-spacing: 0.8px;
    text-transform: uppercase;
    flex: 1;
  }

  /* Active item: MY DRIVE label darker */
  .sidebar-nav-item.active .nav-label {
    color: #44362A;              /* Figma MY DRIVE active text */
    color: #f5e6d3;
  }

  .sidebar-nav-item svg {
    flex-shrink: 0;
    color: #E8E2D6;
  }

  /* Chevron/arrow for MY DRIVE */
  .sidebar-nav-item .nav-arrow {
    margin-left: auto;
    color: #E8E2D6;
  }

  /* Storage section — Figma: Rectangle 33 (#000000 bar, Rect 34 filled %) */
  .sidebar-storage {
    width: 100%;
    padding: 20px 14px 8px 14px;
    margin-top: auto;
  }

  .sidebar-storage-label {
    font-family: 'Outfit', sans-serif;
    font-size: 10px;
    font-weight: 700;
    color: #E8E2D6;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    margin-bottom: 8px;
  }

  .sidebar-storage-track {
    width: 100%;
    height: 9px;
    background-color: #E8E2D6;    /* Figma: Rectangle 33 = #000 but inverted */
    border-radius: 999px;
    overflow: hidden;
  }

  .sidebar-storage-fill {
    height: 100%;
    width: 45%;
    background-color: #C4A070;    /* Figma: Rectangle 34 fill #C4A070 */
    border-radius: 999px;
  }

  /* Bottom user profile — Figma: Rectangle 50 = #E8E2D6, w=370 h=80 */
  .sidebar-user {
    width: 100%;
    background-color: #E8E2D6;   /* Figma: Rectangle 50 */
    padding: 12px 14px;
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 12px;
  }

  .sidebar-user-avatar {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background-color: #C4A071;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    flex-shrink: 0;
  }

  .sidebar-user-avatar svg {
    color: #4E3E2E;
  }

  .sidebar-user-name {
    font-family: 'Outfit', sans-serif;
    font-size: 11px;              /* Figma fs=24 scaled */
    font-weight: 500;
    color: #44362A;               /* Figma Rick and Morty fill=#000 */
    flex: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .sidebar-menu-btn {
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
    color: #44362A;
    flex-shrink: 0;
    display: flex;
    align-items: center;
  }
</style>

<aside class="sidebar">
  <!-- Logo -->
  <a href="/drive" class="sidebar-logo" aria-label="EasyDrive Home">
    <!-- Cloud icon replicating Figma logo shape -->
    <svg viewBox="0 0 52 52" fill="none" xmlns="http://www.w3.org/2000/svg">
      <ellipse cx="26" cy="30" rx="20" ry="13" fill="#E8E2D6"/>
      <ellipse cx="17" cy="26" rx="10" ry="10" fill="#E8E2D6"/>
      <ellipse cx="33" cy="24" rx="12" ry="12" fill="#E8E2D6"/>
      <circle cx="26" cy="20" r="9" fill="#E8E2D6"/>
    </svg>
    <span class="sidebar-logo-text">EasyDrive</span>
  </a>

  <!-- Navigation -->
  <nav class="sidebar-nav">

    <!-- MY DRIVE -->
    <a href="/drive"
       class="sidebar-nav-item <%= (typeof currentPage !== 'undefined' && currentPage === 'home') ? 'active' : '' %>">
      <!-- Folder icon -->
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
           stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/>
      </svg>
      <span class="nav-label">MY DRIVE</span>
      <!-- Arrow indicator (Figma: Polygon 1) -->
      <svg class="nav-arrow" width="10" height="10" viewBox="0 0 24 24" fill="none"
           stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="9 18 15 12 9 6"/>
      </svg>
    </a>

    <!-- SHARED -->
    <a href="/shared"
       class="sidebar-nav-item <%= (typeof currentPage !== 'undefined' && currentPage === 'shared') ? 'active' : '' %>">
      <!-- People icon -->
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
           stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
        <circle cx="9" cy="7" r="4"/>
        <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
        <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
      </svg>
      <span class="nav-label">SHARED</span>
    </a>

    <!-- TRASH -->
    <a href="/trash"
       class="sidebar-nav-item <%= (typeof currentPage !== 'undefined' && currentPage === 'trash') ? 'active' : '' %>">
      <!-- Trash icon -->
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
           stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="3 6 5 6 21 6"/>
        <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/>
        <path d="M10 11v6M14 11v6"/>
        <path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/>
      </svg>
      <span class="nav-label">TRASH</span>
    </a>

    <% if (typeof user !== 'undefined' && user && user.role === 'admin') { %>
    <!-- MANAGEMENT (Admin Only) -->
    <a href="/management"
       class="sidebar-nav-item <%= (typeof currentPage !== 'undefined' && currentPage === 'management') ? 'active' : '' %>">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
           stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
        <circle cx="9" cy="7" r="4"/>
        <circle cx="19" cy="11" r="2"/>
        <path d="M19 8v1M19 13v1M16.5 9.5l.8.8M20.7 11.7l.8.8M16.5 12.5l.8-.8M20.7 10.3l.8-.8"/>
      </svg>
      <span class="nav-label">MANAGEMENT</span>
    </a>

    <!-- AUDIT (Admin Only) -->
    <a href="/audit"
       class="sidebar-nav-item <%= (typeof currentPage !== 'undefined' && currentPage === 'audit') ? 'active' : '' %>">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
           stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
        <polyline points="14 2 14 8 20 8"/>
        <line x1="16" y1="13" x2="8" y2="13"/>
        <line x1="16" y1="17" x2="8" y2="17"/>
        <polyline points="10 9 9 9 8 9"/>
      </svg>
      <span class="nav-label">AUDIT LOGS</span>
    </a>
    <% } %>

  </nav>

  <!-- Storage bar — Figma: Rect33 track + Rect34 fill (#C4A070) -->
  <div class="sidebar-storage">
    <div class="sidebar-storage-label" style="display: flex; justify-content: space-between; align-items: center;">
      <span>STORAGE</span>
      <span style="font-size: 8.5px; opacity: 0.85;"><%= typeof storage !== 'undefined' && storage ? storage.percent + '%' : '0%' %></span>
    </div>
    <div class="sidebar-storage-track" title="<%= typeof storage !== 'undefined' && storage ? storage.percent + '%' : '0%' %>">
      <div class="sidebar-storage-fill" style="width: <%= typeof storage !== 'undefined' && storage ? Math.min(100, Math.max(2, storage.percent)) : 0 %>%;"></div>
    </div>
    <div style="font-size: 8.5px; color: #E8E2D6; margin-top: 5px; opacity: 0.8; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
      <%= typeof storage !== 'undefined' && storage ? storage.formattedUsed + ' / ' + storage.formattedQuota : '0 B / 10 GB' %>
    </div>
  </div>

  <!-- User Profile — Figma: Rectangle 50 bg #E8E2D6 -->
  <div class="sidebar-user">
    <div class="sidebar-user-avatar">
      <% if (typeof user !== 'undefined' && user && user.avatar) { %>
        <img src="<%= user.avatar %>" alt="avatar" style="width:100%;height:100%;object-fit:cover;">
      <% } else { %>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
          <circle cx="12" cy="7" r="4"/>
        </svg>
      <% } %>
    </div>
    <span class="sidebar-user-name">
      <%= (typeof user !== 'undefined' && user) ? user.name : 'Rick and Morty' %>
    </span>
    <button class="sidebar-menu-btn" aria-label="Menu">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
           stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="8" y1="6" x2="21" y2="6"/>
        <line x1="8" y1="12" x2="21" y2="12"/>
        <line x1="8" y1="18" x2="21" y2="18"/>
        <line x1="3" y1="6" x2="3.01" y2="6"/>
        <line x1="3" y1="12" x2="3.01" y2="12"/>
        <line x1="3" y1="18" x2="3.01" y2="18"/>
      </svg>
    </button>
  </div>
</aside>

<!-- Modal แสดงสถานะ User -->
<%- include('../../modals/user-status-modal', { user: typeof user !== 'undefined' ? user : null }) %>

