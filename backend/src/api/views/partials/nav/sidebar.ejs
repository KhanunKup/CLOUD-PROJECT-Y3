<script>
(function () {
  const sidebar = document.querySelector('.sidebar');
  if (!sidebar || sidebar.dataset.resizeReady === 'true') return;
  sidebar.dataset.resizeReady = 'true';

  const root = document.documentElement;
  const toggle = sidebar.querySelector('.sidebar-collapse-toggle');
  const handle = sidebar.querySelector('.sidebar-resize-handle');
  const WIDTH_KEY = 'easydrive.sidebar.width';
  const COLLAPSED_KEY = 'easydrive.sidebar.collapsed';
  const MIN_WIDTH = 200;
  const MAX_WIDTH = 300;
  const DEFAULT_WIDTH = 240;
  const COLLAPSED_WIDTH = 82;
  const MOBILE_QUERY = '(max-width: 760px)';

  function clamp(value, min, max) {
    return Math.min(max, Math.max(min, value));
  }

  function readWidth() {
    try {
      const stored = Number(localStorage.getItem(WIDTH_KEY));
      return Number.isFinite(stored) && stored > 0 ? clamp(stored, MIN_WIDTH, MAX_WIDTH) : DEFAULT_WIDTH;
    } catch (_) {
      return DEFAULT_WIDTH;
    }
  }

  function readCollapsed() {
    try {
      return localStorage.getItem(COLLAPSED_KEY) === 'true';
    } catch (_) {
      return false;
    }
  }

  let expandedWidth = readWidth();
  let collapsed = readCollapsed();
  let dragging = false;

  function saveState() {
    try {
      localStorage.setItem(WIDTH_KEY, String(expandedWidth));
      localStorage.setItem(COLLAPSED_KEY, String(collapsed));
    } catch (_) {}
  }

  function applyState() {
    const isMobile = window.matchMedia(MOBILE_QUERY).matches;
    const compact = isMobile || collapsed;
    const width = compact ? COLLAPSED_WIDTH : expandedWidth;

    root.style.setProperty('--ed-sidebar-width', width + 'px');
    root.style.setProperty('--ed-sidebar-expanded-width', expandedWidth + 'px');
    root.style.setProperty('--ed-sidebar-collapsed-width', COLLAPSED_WIDTH + 'px');
    sidebar.classList.toggle('sidebar-collapsed', compact);

    if (toggle) {
      toggle.setAttribute('aria-expanded', String(!collapsed && !isMobile));
      toggle.setAttribute('aria-label', collapsed ? 'Expand sidebar' : 'Collapse sidebar');
      toggle.setAttribute('title', isMobile ? 'Sidebar is compact on small screens' : (collapsed ? 'Expand sidebar' : 'Collapse sidebar'));
    }
  }

  if (toggle) {
    toggle.addEventListener('click', function () {
      if (window.matchMedia(MOBILE_QUERY).matches) return;
      collapsed = !collapsed;
      saveState();
      applyState();
    });
  }

  if (handle) {
    handle.addEventListener('pointerdown', function (event) {
      if (window.matchMedia(MOBILE_QUERY).matches || event.button !== 0) return;
      dragging = true;
      collapsed = false;
      sidebar.classList.remove('sidebar-collapsed');
      root.classList.add('ed-sidebar-resizing');
      applyState();
      if (handle.setPointerCapture) {
        try { handle.setPointerCapture(event.pointerId); } catch (_) {}
      }
      event.preventDefault();
    });
  }

  if (handle) {
    handle.addEventListener('keydown', function (event) {
      if (window.matchMedia(MOBILE_QUERY).matches) return;
      if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
      event.preventDefault();
      expandedWidth = clamp(expandedWidth + (event.key === 'ArrowRight' ? 10 : -10), MIN_WIDTH, MAX_WIDTH);
      collapsed = false;
      applyState();
      saveState();
    });
  }

  window.addEventListener('pointermove', function (event) {
    if (!dragging) return;
    const nextWidth = clamp(event.clientX, MIN_WIDTH, MAX_WIDTH);
    expandedWidth = nextWidth;
    collapsed = false;
    root.style.setProperty('--ed-sidebar-width', expandedWidth + 'px');
    root.style.setProperty('--ed-sidebar-expanded-width', expandedWidth + 'px');
    sidebar.classList.remove('sidebar-collapsed');
    if (toggle) {
      toggle.setAttribute('aria-expanded', 'true');
      toggle.setAttribute('aria-label', 'Collapse sidebar');
      toggle.setAttribute('title', 'Collapse sidebar');
    }
  });

  function stopDragging() {
    if (!dragging) return;
    dragging = false;
    root.classList.remove('ed-sidebar-resizing');
    expandedWidth = clamp(expandedWidth, MIN_WIDTH, MAX_WIDTH);
    saveState();
    applyState();
  }

  window.addEventListener('pointerup', stopDragging);
  window.addEventListener('pointercancel', stopDragging);
  window.addEventListener('resize', applyState);

  applyState();
})();
</script>
