<%# PARTIAL: sidebar.ejs | Usage: include('../partials/nav/sidebar', { currentPage: 'home|shared|trash' }) %>

<style>
  .sidebar {
    width: 220px;
    min-height: 100vh;
    background-color: #7b573b;
    background-image: linear-gradient(155deg, #a07a59 0%, #8b6749 28%, #7f5b3d 62%, #6b482f 100%);
    background-repeat: no-repeat;
    background-size: 100% 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 24px 0 14px;
    position: fixed;
    top: 0;
    left: 0;
    bottom: 0;
    z-index: 100;
    isolation: isolate;
    border-right: 1px solid rgba(255, 247, 232, .32);
    box-shadow: 8px 0 30px rgba(57, 37, 24, .14);
  }

  .sidebar-logo {
    width: calc(100% - 24px);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    margin-bottom: 26px;
    padding: 38px 0 24px;
    text-decoration: none;
    border-bottom: 1px solid rgba(255, 245, 228, .24);
    position: relative;
  }

  .sidebar-logo-image {
    display: block;
    width: min(100%, 230px);
    max-width: 230px;
    height: auto;
    max-height: none;
    object-fit: contain;
    object-position: center;
    flex-shrink: 0;
    overflow: visible;
    filter: drop-shadow(0 6px 12px rgba(48, 31, 21, .22));
  }

  .sidebar-nav {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 7px;
    padding: 0 12px;
  }

  .sidebar-nav-item {
    min-height: 50px;
    display: flex;
    align-items: center;
    gap: 13px;
    padding: 13px 15px;
    border: 1px solid transparent;
    border-radius: 14px;
    cursor: pointer;
    text-decoration: none;
    transition: background .2s ease, border-color .2s ease, transform .2s ease, box-shadow .2s ease;
    position: relative;
    background: rgba(255, 246, 231, .035);
  }

  .sidebar-nav-item:hover {
    background: rgba(255, 246, 231, .13);
    border-color: rgba(255, 246, 231, .10);
    transform: translateX(2px);
  }

  .sidebar-nav-item.active {
    background: linear-gradient(135deg, #4d392c 0%, #3d2b21 100%);
    border-color: rgba(255, 230, 194, .17);
    box-shadow: 0 8px 18px rgba(43, 27, 18, .20), inset 0 1px 0 rgba(255, 255, 255, .06);
  }

  .sidebar-nav-item.active::before {
    content: "";
    position: absolute;
    left: -1px;
    top: 11px;
    bottom: 11px;
    width: 4px;
    border-radius: 0 5px 5px 0;
    background: linear-gradient(180deg, #f5d3a4, #d5a875);
    box-shadow: 0 0 12px rgba(245, 211, 164, .28);
  }

  .sidebar-nav-item .nav-label {
    font-family: 'Outfit', sans-serif;
    font-size: 13px;
    font-weight: 700;
    color: #fff0dc;
    letter-spacing: .55px;
    text-transform: uppercase;
    flex: 1;
    white-space: nowrap;
  }

  .sidebar-nav-item.active .nav-label {
    color: #fff5e8;
  }

  .sidebar-nav-item svg {
    width: 21px !important;
    height: 21px !important;
    flex-shrink: 0;
    color: #f7e7d1;
  }

  .sidebar-nav-item .nav-arrow {
    width: 12px !important;
    height: 12px !important;
    margin-left: auto;
    opacity: .82;
  }

  .sidebar-storage {
    width: calc(100% - 24px);
    padding: 15px 14px 13px;
    margin: auto 12px 4px;
    position: relative;
    cursor: pointer;
    border-radius: 16px;
    border: 1px solid rgba(255, 244, 224, .15);
    background: linear-gradient(145deg, rgba(58, 38, 26, .24), rgba(255, 244, 224, .06));
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, .06);
  }

  .sidebar-storage-label {
    font-family: 'Outfit', sans-serif;
    font-size: 11px;
    font-weight: 700;
    color: #fff0dc;
    letter-spacing: 1.3px;
    text-transform: uppercase;
    margin-bottom: 9px;
  }

  .sidebar-storage-label .storage-percent-label {
    font-size: 10px !important;
    letter-spacing: .4px;
  }

  .sidebar-storage-track {
    width: 100%;
    height: 8px;
    background-color: rgba(255, 244, 224, .72);
    border-radius: 999px;
    overflow: hidden;
    display: flex;
    box-shadow: inset 0 1px 2px rgba(47, 30, 20, .22);
  }

  .storage-seg {
    height: 100%;
    transition: width .3s ease;
  }
  .storage-seg.seg-doc { background-color: #79b5e2; }
  .storage-seg.seg-img { background-color: #f1a05f; }
  .storage-seg.seg-code { background-color: #a4c77e; }
  .storage-seg.seg-archive { background-color: #c0a4c0; }
  .storage-seg.seg-other { background-color: #c6c3bd; }

  .sidebar-storage-fill {
    height: 100%;
    width: 0%;
    background: linear-gradient(90deg, #e6b67e, #f5d8ac);
    border-radius: 999px;
    transition: width .3s ease;
  }

  .storage-text-summary {
    font-size: 10px !important;
    color: rgba(255, 240, 220, .86) !important;
    margin-top: 7px !important;
    letter-spacing: .1px;
  }

  .storage-popover {
    display: none;
    position: fixed;
    bottom: 94px;
    left: 230px;
    width: 260px;
    background: #fffaf3;
    color: #44362a;
    border: 1px solid rgba(126, 87, 56, .13);
    border-radius: 16px;
    box-shadow: 0 18px 42px rgba(47, 30, 20, .22);
    padding: 16px 17px;
    z-index: 1000;
    font-family: 'Outfit', sans-serif;
    pointer-events: none;
  }

  .sidebar-storage:hover .storage-popover,
  .sidebar-storage.popover-open .storage-popover {
    display: block;
    pointer-events: auto;
  }

  .storage-popover::after {
    content: '';
    position: absolute;
    bottom: 20px;
    left: -7px;
    border-width: 7px 7px 7px 0;
    border-style: solid;
    border-color: transparent #fffaf3 transparent transparent;
  }

  .storage-popover-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 12px;
    font-weight: 700;
    border-bottom: 1px solid #eee1d2;
    padding-bottom: 9px;
    margin-bottom: 10px;
    text-transform: uppercase;
    color: #6b5140;
  }

  .storage-popover-header .popover-total {
    font-size: 11px;
    font-weight: 500;
    color: #8c7b6b;
  }

  .storage-popover-list {
    display: flex;
    flex-direction: column;
    gap: 9px;
    font-size: 12px;
  }

  .popover-item {
    display: flex;
    align-items: center;
    gap: 9px;
  }

  .popover-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .popover-dot.dot-doc { background-color: #5b9bd5; }
  .popover-dot.dot-img { background-color: #ed7d31; }
  .popover-dot.dot-code { background-color: #70ad47; }
  .popover-dot.dot-archive { background-color: #99738e; }
  .popover-dot.dot-other { background-color: #a5a5a5; }

  .popover-cat {
    flex: 1;
    color: #44362a;
  }

  .popover-val {
    font-weight: 600;
    color: #2d251e;
    font-size: 12px;
  }

  .storage-popover-footer {
    margin-top: 12px;
    padding-top: 9px;
    border-top: 1px dashed #e0d2c2;
    font-size: 11px;
    color: #7a6f64;
    display: flex;
    justify-content: space-between;
  }

  .storage-popover-footer strong {
    color: #46724c;
  }

  .sidebar-user {
    width: calc(100% - 24px);
    background: linear-gradient(135deg, rgba(255, 249, 239, .96), rgba(238, 222, 200, .96));
    padding: 12px 13px;
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 12px 12px 0;
    border: 1px solid rgba(255, 255, 255, .48);
    border-radius: 15px;
    box-shadow: 0 8px 22px rgba(48, 31, 20, .15), inset 0 1px 0 rgba(255, 255, 255, .7);
  }

  .sidebar-user-avatar {
    width: 38px;
    height: 38px;
    border: 2px solid rgba(255, 250, 241, .8);
    border-radius: 50%;
    background: linear-gradient(145deg, #e7c18e, #c79b67);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    flex-shrink: 0;
    box-shadow: 0 3px 8px rgba(84, 56, 34, .12);
  }

  .sidebar-user-avatar svg {
    color: #4e3e2e;
  }

  .sidebar-user-name {
    font-family: 'Outfit', sans-serif;
    font-size: 13px;
    font-weight: 600;
    color: #44362a;
    flex: 1;
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .sidebar-menu-btn {
    background: rgba(132, 97, 69, .08);
    border: 1px solid rgba(132, 97, 69, .10);
    border-radius: 8px;
    cursor: pointer;
    padding: 7px;
    color: #634832;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background .2s ease;
  }

  .sidebar-menu-btn:hover {
    background: rgba(132, 97, 69, .17);
  }

  @media (max-width: 1100px) {
    .sidebar { width: 200px; }
    .storage-popover { left: 210px; }
    .sidebar-nav { padding: 0 10px; }
    .sidebar-nav-item { padding-left: 13px; padding-right: 13px; }
  }

  @media (max-width: 760px) {
    .sidebar {
      width: 80px;
      padding-top: 18px;
    }

    .sidebar-logo {
      width: calc(100% - 18px);
      margin-bottom: 21px;
      padding-bottom: 18px;
    }

    .sidebar-nav { padding: 0 8px; gap: 8px; }

    .sidebar-nav-item {
      justify-content: center;
      width: 52px;
      min-height: 50px;
      margin: 0 auto;
      padding: 12px 0;
      gap: 0;
    }

    .sidebar-nav-item .nav-label {
      position: absolute;
      left: calc(100% + 12px);
      top: 50%;
      z-index: 1002;
      width: max-content;
      max-width: 200px;
      padding: 9px 12px;
      border-radius: 9px;
      background: #443126;
      color: #fff3e2;
      font-size: 12px;
      letter-spacing: .4px;
      opacity: 0;
      visibility: hidden;
      transform: translateY(-50%) translateX(-4px);
      box-shadow: 0 8px 22px rgba(37, 24, 17, .22);
      pointer-events: none;
      transition: opacity .15s ease, transform .15s ease, visibility .15s ease;
    }

    .sidebar-nav-item:hover .nav-label,
    .sidebar-nav-item:focus-visible .nav-label {
      opacity: 1;
      visibility: visible;
      transform: translateY(-50%) translateX(0);
    }

    .sidebar-nav-item .nav-arrow { display: none; }
    .sidebar-storage {
      width: calc(100% - 16px);
      margin: auto 8px 4px;
      padding: 8px 7px;
      border-radius: 12px;
    }

    .sidebar-storage-label,
    .storage-text-summary { display: none !important; }
    .sidebar-storage-track { height: 7px; }
    .storage-popover { left: 90px; bottom: 84px; width: 238px; }

    .sidebar-user {
      width: calc(100% - 16px);
      justify-content: center;
      margin: 10px 8px 0;
      padding: 9px 5px;
      border-radius: 12px;
    }

    .sidebar-user-avatar { width: 38px; height: 38px; }
    .sidebar-user-name,
    .sidebar-menu-btn { display: none; }
  }
</style>

<style>
  :root {
    --ed-sidebar-width: 240px;
    --ed-sidebar-expanded-width: 240px;
    --ed-sidebar-collapsed-width: 82px;
  }

  .sidebar {
    width: var(--ed-sidebar-width, 240px) !important;
    transition: width .22s ease, background-position .25s ease;
  }

  .page-layout > .sidebar-spacer {
    display: block !important;
    width: var(--ed-sidebar-width, 240px) !important;
    min-width: var(--ed-sidebar-width, 240px) !important;
    flex: 0 0 var(--ed-sidebar-width, 240px) !important;
    transition: width .22s ease, min-width .22s ease, flex-basis .22s ease;
  }

  .main-content {
    width: calc(100% - var(--ed-sidebar-width, 240px)) !important;
    margin-left: var(--ed-sidebar-width, 240px) !important;
    min-width: 0;
    transition: width .22s ease, margin-left .22s ease;
  }

  .page-layout > .main-content {
    flex: 1 1 0 !important;
    width: auto !important;
    min-width: 0 !important;
    margin-left: 0 !important;
  }

  .sidebar-collapse-toggle {
    position: absolute;
    top: 22px;
    right: 13px;
    z-index: 6;
    width: 34px;
    height: 34px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(255, 243, 224, .25);
    border-radius: 11px;
    background: rgba(255, 248, 235, .12);
    color: #fff0dc;
    cursor: pointer;
    box-shadow: inset 0 1px 0 rgba(255,255,255,.10);
    transition: background .18s ease, transform .18s ease, border-color .18s ease;
  }

  .sidebar-collapse-toggle:hover {
    background: rgba(255, 248, 235, .23);
    border-color: rgba(255, 243, 224, .42);
    transform: translateY(-1px);
  }

  .sidebar-collapse-toggle svg {
    transition: transform .22s ease;
  }

  .sidebar.sidebar-collapsed .sidebar-collapse-toggle svg {
    transform: rotate(180deg);
  }

  .sidebar-resize-handle {
    position: absolute;
    top: 50%;
    right: -7px;
    transform: translateY(-50%);
    z-index: 20;
    width: 15px;
    height: 72px;
    padding: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    border: 1px solid rgba(255, 244, 226, .70);
    border-radius: 999px;
    background: linear-gradient(180deg, #f5dfc1, #d6b083);
    box-shadow: 0 4px 14px rgba(51, 32, 20, .22);
    cursor: col-resize;
    touch-action: none;
  }

  .sidebar-resize-handle span {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: #78563c;
    opacity: .9;
  }

  .sidebar.sidebar-collapsed .sidebar-logo {
    display: none !important;
  }

  .sidebar.sidebar-collapsed .sidebar-logo-image {
    display: none !important;
  }

  .sidebar.sidebar-collapsed .sidebar-nav {
    padding: 0 8px;
    gap: 8px;
    margin-top: 44px;
  }

  .sidebar.sidebar-collapsed .sidebar-nav-item {
    justify-content: center;
    width: 54px;
    min-height: 50px;
    margin: 0 auto;
    padding: 12px 0;
    gap: 0;
  }

  .sidebar.sidebar-collapsed .sidebar-nav-item .nav-label {
    position: absolute;
    left: calc(100% + 12px);
    top: 50%;
    z-index: 1002;
    width: max-content;
    max-width: 210px;
    padding: 9px 12px;
    border: 1px solid rgba(255, 240, 220, .16);
    border-radius: 9px;
    background: #443126;
    color: #fff3e2;
    font-size: 12px;
    letter-spacing: .4px;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-50%) translateX(-4px);
    box-shadow: 0 8px 22px rgba(37, 24, 17, .22);
    pointer-events: none;
    transition: opacity .15s ease, transform .15s ease, visibility .15s ease;
  }

  .sidebar.sidebar-collapsed .sidebar-nav-item:hover .nav-label,
  .sidebar.sidebar-collapsed .sidebar-nav-item:focus-visible .nav-label {
    opacity: 1;
    visibility: visible;
    transform: translateY(-50%) translateX(0);
  }

  .sidebar.sidebar-collapsed .sidebar-nav-item .nav-arrow {
    display: none;
  }

  .sidebar.sidebar-collapsed .sidebar-storage {
    width: calc(100% - 16px);
    margin: auto 8px 4px;
    padding: 8px 7px;
    border-radius: 12px;
  }

  .sidebar.sidebar-collapsed .sidebar-storage-label,
  .sidebar.sidebar-collapsed .storage-text-summary {
    display: none !important;
  }

  .sidebar.sidebar-collapsed .sidebar-storage-track {
    height: 7px;
  }

  .sidebar .storage-popover {
    left: calc(var(--ed-sidebar-width, 240px) + 10px) !important;
  }

  .sidebar.sidebar-collapsed .sidebar-user {
    width: calc(100% - 16px);
    justify-content: center;
    margin: 10px 8px 0;
    padding: 9px 5px;
    border-radius: 12px;
  }

  .sidebar.sidebar-collapsed .sidebar-user-name,
  .sidebar.sidebar-collapsed .sidebar-menu-btn {
    display: none;
  }

  .ed-sidebar-resizing,
  .ed-sidebar-resizing * {
    cursor: col-resize !important;
    user-select: none !important;
  }

  @media (max-width: 760px) {
    .sidebar {
      width: 82px !important;
      padding-top: 18px;
    }

    .page-layout > .sidebar-spacer {
      width: 82px !important;
      min-width: 82px !important;
      flex-basis: 82px !important;
    }

    .main-content {
      width: calc(100% - 82px) !important;
      margin-left: 82px !important;
    }

    .page-layout > .main-content {
      width: auto !important;
      min-width: 0 !important;
      margin-left: 0 !important;
    }

    .sidebar-collapse-toggle,
    .sidebar-resize-handle {
      display: none !important;
    }

    .sidebar.sidebar-collapsed .sidebar-nav {
      margin-top: 0 !important;
    }

    .sidebar:not(.sidebar-collapsed) .sidebar-logo {
      width: calc(100% - 16px);
      margin-bottom: 22px;
      padding-bottom: 18px;
    }

    .sidebar:not(.sidebar-collapsed) .sidebar-nav {
      padding: 0 8px;
      gap: 8px;
    }

    .sidebar:not(.sidebar-collapsed) .sidebar-nav-item {
      justify-content: center;
      width: 54px;
      min-height: 50px;
      margin: 0 auto;
      padding: 12px 0;
      gap: 0;
    }

    .sidebar:not(.sidebar-collapsed) .sidebar-nav-item .nav-label {
      position: absolute;
      left: calc(100% + 12px);
      top: 50%;
      z-index: 1002;
      width: max-content;
      max-width: 210px;
      padding: 9px 12px;
      border-radius: 9px;
      background: #443126;
      color: #fff3e2;
      font-size: 12px;
      opacity: 0;
      visibility: hidden;
      transform: translateY(-50%);
      box-shadow: 0 8px 22px rgba(37, 24, 17, .22);
      pointer-events: none;
    }

    .sidebar:not(.sidebar-collapsed) .sidebar-nav-item:hover .nav-label,
    .sidebar:not(.sidebar-collapsed) .sidebar-nav-item:focus-visible .nav-label {
      opacity: 1;
      visibility: visible;
    }

    .sidebar:not(.sidebar-collapsed) .sidebar-nav-item .nav-arrow {
      display: none;
    }

    .sidebar:not(.sidebar-collapsed) .sidebar-storage {
      width: calc(100% - 16px);
      margin: auto 8px 4px;
      padding: 8px 7px;
      border-radius: 12px;
    }

    .sidebar:not(.sidebar-collapsed) .sidebar-storage-label,
    .sidebar:not(.sidebar-collapsed) .storage-text-summary {
      display: none !important;
    }

    .sidebar:not(.sidebar-collapsed) .sidebar-user {
      width: calc(100% - 16px);
      justify-content: center;
      margin: 10px 8px 0;
      padding: 9px 5px;
      border-radius: 12px;
    }

    .sidebar:not(.sidebar-collapsed) .sidebar-user-name,
    .sidebar:not(.sidebar-collapsed) .sidebar-menu-btn {
      display: none;
    }
  }
</style>

<aside class="sidebar">
  <button class="sidebar-collapse-toggle" type="button" aria-label="Collapse sidebar" aria-expanded="true" title="Collapse sidebar">
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <polyline points="15 18 9 12 15 6"></polyline>
    </svg>
  </button>
  <button class="sidebar-resize-handle" type="button" aria-label="Resize sidebar" title="Drag to resize sidebar">
    <span></span><span></span><span></span>
  </button>
  <a href="/drive" class="sidebar-logo" aria-label="EasyDrive Home">
    <img
      src="/images/easydrive-logo.png"
      class="sidebar-logo-image"
      alt="EasyDrive"
    >
  </a>

  <!-- Navigation -->
  <nav class="sidebar-nav">

    <!-- MY DRIVE -->
    <a href="/drive"
       class="sidebar-nav-item <%= (typeof currentPage !== 'undefined' && currentPage === 'home') ? 'active' : '' %>">
      <!-- Folder icon -->
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
           stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/>
      </svg>
      <span class="nav-label">MY DRIVE</span>
      <!-- Arrow indicator (Figma: Polygon 1) -->
      <svg class="nav-arrow" width="10" height="10" viewBox="0 0 24 24" fill="none"
           stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="9 18 15 12 9 6"/>
      </svg>
    </a>

    <!-- SHARED -->
    <a href="/shared"
       class="sidebar-nav-item <%= (typeof currentPage !== 'undefined' && currentPage === 'shared') ? 'active' : '' %>">
      <!-- People icon -->
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
           stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
        <circle cx="9" cy="7" r="4"/>
        <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
        <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
      </svg>
      <span class="nav-label">SHARED</span>
    </a>

    <!-- TRASH -->
    <a href="/trash"
       class="sidebar-nav-item <%= (typeof currentPage !== 'undefined' && currentPage === 'trash') ? 'active' : '' %>">
      <!-- Trash icon -->
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
           stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="3 6 5 6 21 6"/>
        <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/>
        <path d="M10 11v6M14 11v6"/>
        <path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/>
      </svg>
      <span class="nav-label">TRASH</span>
    </a>

    <% if (typeof user !== 'undefined' && user && user.role === 'admin') { %>
    <!-- MANAGEMENT (Admin Only) -->
