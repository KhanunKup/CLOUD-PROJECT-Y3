  <!-- Storage bar — Multi-color Segments & Breakdown Popover -->
  <div class="sidebar-storage" id="sidebarStorageSection">
    <div class="sidebar-storage-label" style="display: flex; justify-content: space-between; align-items: center;">
      <span>STORAGE</span>
      <span class="storage-percent-label" style="font-size: 10px; opacity: 0.9;"><%= typeof storage !== 'undefined' && storage ? storage.percent + '%' : '0%' %></span>
    </div>
    <div class="sidebar-storage-track" id="sidebarStorageTrack" title="Click or hover for storage breakdown">
      <% if (typeof storage !== 'undefined' && storage && storage.breakdownPercent) { %>
        <% const bp = storage.breakdownPercent; %>
        <div class="storage-seg seg-doc" style="width: <%= bp.document || 0 %>%;" title="Documents: <%= storage.breakdownFormatted ? storage.breakdownFormatted.document : '' %>"></div>
        <div class="storage-seg seg-img" style="width: <%= bp.image || 0 %>%;" title="Images: <%= storage.breakdownFormatted ? storage.breakdownFormatted.image : '' %>"></div>
        <div class="storage-seg seg-code" style="width: <%= bp.code || 0 %>%;" title="Code: <%= storage.breakdownFormatted ? storage.breakdownFormatted.code : '' %>"></div>
        <div class="storage-seg seg-archive" style="width: <%= bp.archive || 0 %>%;" title="Archives: <%= storage.breakdownFormatted ? storage.breakdownFormatted.archive : '' %>"></div>
        <div class="storage-seg seg-other" style="width: <%= (bp.other || 0) + (bp.video || 0) + (bp.audio || 0) %>%;" title="Other: <%= storage.breakdownFormatted ? storage.breakdownFormatted.other : '' %>"></div>
      <% } else { %>
        <div class="sidebar-storage-fill" style="width: <%= typeof storage !== 'undefined' && storage ? Math.min(100, Math.max(2, storage.percent)) : 0 %>%;"></div>
      <% } %>
    </div>
    <div class="storage-text-summary" style="font-size: 10px; color: #FFF0DC; margin-top: 7px; opacity: 0.9; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
      <span class="storage-used-quota-text"><%= typeof storage !== 'undefined' && storage ? storage.formattedUsed + ' / ' + storage.formattedQuota : '0 B / 10 GB' %></span>
    </div>

    <!-- Storage Popover Card -->
    <div class="storage-popover" id="storagePopover">
      <div class="storage-popover-header">
        <span>Storage Breakdown</span>
        <span class="popover-total"><%= typeof storage !== 'undefined' && storage ? storage.formattedUsed : '0 B' %></span>
      </div>
      <div class="storage-popover-list">
        <div class="popover-item">
          <span class="popover-dot dot-doc"></span>
          <span class="popover-cat">Documents</span>
          <span class="popover-val doc-val"><%= (typeof storage !== 'undefined' && storage && storage.breakdownFormatted) ? storage.breakdownFormatted.document : '0 B' %></span>
        </div>
        <div class="popover-item">
          <span class="popover-dot dot-img"></span>
          <span class="popover-cat">Images</span>
          <span class="popover-val img-val"><%= (typeof storage !== 'undefined' && storage && storage.breakdownFormatted) ? storage.breakdownFormatted.image : '0 B' %></span>
        </div>
        <div class="popover-item">
          <span class="popover-dot dot-code"></span>
          <span class="popover-cat">Code</span>
          <span class="popover-val code-val"><%= (typeof storage !== 'undefined' && storage && storage.breakdownFormatted) ? storage.breakdownFormatted.code : '0 B' %></span>
        </div>
        <div class="popover-item">
          <span class="popover-dot dot-archive"></span>
          <span class="popover-cat">Archives</span>
          <span class="popover-val archive-val"><%= (typeof storage !== 'undefined' && storage && storage.breakdownFormatted) ? storage.breakdownFormatted.archive : '0 B' %></span>
        </div>
        <div class="popover-item">
          <span class="popover-dot dot-other"></span>
          <span class="popover-cat">Other files</span>
          <span class="popover-val other-val"><%= (typeof storage !== 'undefined' && storage && storage.breakdownFormatted) ? storage.breakdownFormatted.other : '0 B' %></span>
        </div>
      </div>
      <div class="storage-popover-footer">
        <span>Free: <strong class="free-val"><%= (typeof storage !== 'undefined' && storage && storage.formattedFree) ? storage.formattedFree : '10 GB' %></strong></span>
        <span>Quota: <%= (typeof storage !== 'undefined' && storage) ? storage.formattedQuota : '10 GB' %></span>
      </div>
    </div>
  </div>

  <!-- User Profile — Figma: Rectangle 50 bg #E8E2D6 -->
  <div class="sidebar-user">
    <div class="sidebar-user-avatar">
      <% if (typeof user !== 'undefined' && user && user.avatar) { %>
