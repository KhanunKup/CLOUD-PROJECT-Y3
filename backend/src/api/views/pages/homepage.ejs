<!-- views/pages/homepage.ejs -->
<!DOCTYPE html>
<html lang="th">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MY DRIVE - EASYDRIVE</title>

    <!-- FontAwesome สำหรับไอคอน -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

    <!-- CSS สำหรับ Menu Dropdown -->
    <link rel="stylesheet" href="/css/menu.css">
    <!-- CSS โครงสร้างหลัก -->
    <link rel="stylesheet" href="/css/homepage.css">
</head>

<body>
<div class="page-layout">

    <!-- Sidebar partial — currentPage='home' -->
    <%- include('../partials/nav/sidebar', { currentPage: 'home', user: typeof user !== 'undefined' ? user : null }) %>
    <div class="sidebar-spacer"></div>

    <main class="main-content">
        <!-- Topbar: Search Bar + New Action (Figma Style) -->
        <div class="topbar">
            <div class="search-wrapper">
                <svg class="search-icon" width="18" height="18" viewBox="0 0 24 24"
                     fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
                </svg>
                <input class="search-input" type="text" placeholder="Search in Drive" />
            </div>
            <div class="new-action-wrapper">
                <button class="btn-new" id="btnNew">+ New</button>
                <%- include('../menus/new-option-menu') %>
            </div>
        </div>

        <!-- Title Row — Figma: fill=#423E3B fs=70 -->
        <div class="title-row">
            <h1 class="page-title">MY DRIVE</h1>
        </div>

        <!-- Category Filter Chips -->
        <div class="category-filters" id="categoryFilters">
            <button type="button" class="category-chip active" data-category="all">
                <i class="fas fa-th-large"></i> All
            </button>
            <button type="button" class="category-chip" data-category="document">
                <i class="fas fa-file-alt"></i> Documents
            </button>
            <button type="button" class="category-chip" data-category="image">
                <i class="fas fa-image"></i> Images
            </button>
            <button type="button" class="category-chip" data-category="code">
                <i class="fas fa-code"></i> Code
            </button>
            <button type="button" class="category-chip" data-category="archive">
                <i class="fas fa-file-archive"></i> Archives
            </button>
            <button type="button" class="category-chip" data-category="folder">
                <i class="fas fa-folder"></i> Folders
            </button>
        </div>

        <!-- Breadcrumb Trail -->
        <div class="drive-breadcrumbs" id="driveBreadcrumbs">
            <% (typeof breadcrumbs !== 'undefined' && breadcrumbs && breadcrumbs.length > 0 ? breadcrumbs : [{ name: 'My Drive', url: '/drive' }]).forEach(function(crumb, index, arr) { %>
                <% if (index === arr.length - 1) { %>
                    <span class="crumb-current">
                        <i class="fas <%= index === 0 ? 'fa-hdd' : 'fa-folder-open' %>"></i> <%= crumb.name %>
                    </span>
                <% } else { %>
                    <a href="<%= crumb.url %>" class="crumb-link">
                        <i class="fas <%= index === 0 ? 'fa-hdd' : 'fa-folder' %>"></i> <%= crumb.name %>
                    </a>
                    <span class="crumb-separator"><i class="fas fa-chevron-right"></i></span>
                <% } %>
            <% }); %>
        </div>

        <!-- File Table -->
        <div class="file-table-container">
            <div class="file-table-header">
                <span>Name</span>
                <span>Owner</span>
                <span>Date Uploaded</span>
                <span></span>
            </div>

            <!-- รายการไฟล์จาก Backend -->
            <% if (typeof files !== 'undefined' && files && files.length > 0) { %>
                <% files.forEach(function(file) { %>
                <div class="file-row <%= file.type === 'folder' ? 'folder-row' : '' %>"
                     data-id="<%= file.id %>"
                     data-name="<%= file.name %>"
                     data-type="<%= file.type %>"
                     data-folder-id="<%= file.folderId || '' %>"
                     data-category="<%= file.category || 'other' %>"
                     data-tags="<%= (file.tags || []).join(',') %>">
                    <div class="file-name">
                        <% if (file.type === 'folder') { %>
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                                 stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/>
                            </svg>
                        <% } else { %>
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                                 stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                                <polyline points="14 2 14 8 20 8"/>
                            </svg>
                        <% } %>
                        <span class="file-name-text"><%= file.name %></span>

                        <!-- Tag Badges -->
                        <div class="file-tags-wrapper">
                            <% (file.tags || []).forEach(function(tag) { %>
                                <span class="file-tag-badge" title="Tag: <%= tag %>"><%= tag %></span>
                            <% }); %>
                        </div>

                        <% if (file.isShared) { %>
                            <span class="shared-badge-inline open-share-modal" 
                                  title="Click to edit share settings"
                                  data-id="<%= file.id %>" 
                                  data-share-id="<%= file.shareId %>" 
                                  data-filename="<%= file.name %>" 
                                  data-mode="edit"
                                  data-expire-hours="<%= file.shareExpireHours || '24' %>"
                                  data-max-downloads="<%= file.shareMaxDownloads !== undefined ? file.shareMaxDownloads : '0' %>"
                                  data-has-password="<%= file.hasPassword ? 'true' : 'false' %>"
                                  data-share-url="<%= file.shareUrl || '' %>"
                                  data-access="<%= encodeURIComponent(JSON.stringify(file.accessList || [])) %>">
                                <i class="fas fa-link"></i> Shared
                            </span>
                        <% } %>
                    </div>
                    <div class="file-owner">
                        <div class="owner-avatar">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none"
                                 stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                                <circle cx="12" cy="7" r="4"/>
                            </svg>
                        </div>
                        <%= file.owner || 'me' %>
                    </div>
                    <div class="file-date"><%= file.uploadDate || file.uploadedAt || '—' %></div>
                    <div class="options-wrapper">
                        <button class="options-btn toggle-options" aria-label="Options"><i class="fas fa-ellipsis-v"></i></button>
                        <%- include(file.type === 'folder' ? '../menus/folder-option-menu' : '../menus/file-option-menu', { file: file }) %>
                    </div>
                </div>
                <% }); %>
            <% } else { %>
                <div class="empty-state"><%= (typeof currentFolderId !== 'undefined' && currentFolderId) ? 'This folder is empty. Click "+ New" to add files or subfolders.' : 'No files found.' %></div>
            <% } %>
        </div>
    </main>
</div>

<!-- ดึง Modal ต่างๆ มาใช้ตรงนี้ -->
<%- include('../modals/share-modal') %>
<%- include('../modals/manage-access-modal') %>
<%- include('../modals/rename-modal') %>
<%- include('../modals/new-folder-modal') %>
<%- include('../modals/upload-modal') %>
<%- include('../modals/tags-modal') %>
<%- include('../modals/confirm-modal') %>
<%- include('../modals/preview-modal') %>

<!-- เรียกใช้ JS ของ Menu Dropdown -->
<script src="/js/toast.js"></script>
<script src="/js/menu.js"></script>
</body>
</html>