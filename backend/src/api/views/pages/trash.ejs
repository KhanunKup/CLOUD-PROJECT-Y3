<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Trash — EasyDrive</title>
  <!-- FontAwesome สำหรับไอคอน -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
  <!-- CSS สำหรับ Menu Dropdown -->
  <link rel="stylesheet" href="/css/menu.css">
  <!-- CSS โครงสร้างหลัก -->
  <link rel="stylesheet" href="/css/homepage.css">
</head>
<body>
<div class="page-layout">

  <!-- Sidebar partial — currentPage='trash' highlights TRASH item -->
  <%- include('../partials/nav/sidebar', { currentPage: 'trash', user: typeof user !== 'undefined' ? user : null }) %>
  <div class="sidebar-spacer"></div>

  <main class="main-content">
    <div class="topbar">
      <div class="search-wrapper">
        <svg class="search-icon" width="18" height="18" viewBox="0 0 24 24"
             fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
        <input class="search-input" type="text" placeholder="Search in Drive" />
        <button type="button" class="search-clear-btn" id="searchClearBtn" aria-label="Clear search" title="Clear search" style="display: none;">&times;</button>
      </div>
      <% if (typeof files !== 'undefined' && files && files.length > 0) { %>
      <form action="/trash/empty" method="POST" style="margin-left:auto;" id="emptyTrashForm" onsubmit="event.preventDefault(); if (window.executeOptimisticEmptyTrash) { window.executeOptimisticEmptyTrash(); } else { this.submit(); }">
        <button class="btn-empty-trash" type="submit">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
               stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="3 6 5 6 21 6"/>
            <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/>
            <path d="M10 11v6M14 11v6"/>
          </svg>
          Empty Trash
        </button>
      </form>
      <% } %>
    </div>

    <!-- Figma: TRASH text fill=#423E3B fs=70 -->
    <div class="title-row">
      <h1 class="page-title">TRASH</h1>
    </div>

    <!-- File Table — Trash has extra Restore action column -->
    <div class="file-table-container trash-table">
      <div class="file-table-header">
        <span class="sortable-col" data-sort="name">Name <span class="sort-icon"><i class="fas fa-sort"></i></span></span>
        <span class="sortable-col" data-sort="owner">Owner <span class="sort-icon"><i class="fas fa-sort"></i></span></span>
        <span class="sortable-col sort-active" data-sort="date">Date Trashed <span class="sort-icon"><i class="fas fa-arrow-down"></i></span></span>
        <span>Restore</span>
        <span></span>
      </div>

      <% if (typeof files !== 'undefined' && files && files.length > 0) { %>
        <% files.forEach(function(file) { %>
        <div class="file-row <%= file.type === 'folder' ? 'folder-row' : '' %>" data-id="<%= file.id %>" data-name="<%= file.name %>" data-type="<%= file.type %>" data-date="<%= file.trashedAt || file.createdAt || file.uploadedAt || '' %>">
          <div class="file-name">
            <% if (file.type === 'folder') { %>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                   stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/>
              </svg>
            <% } else { %>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                   stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                <polyline points="14 2 14 8 20 8"/>
              </svg>
            <% } %>
            <%= file.name %>
          </div>
          <div class="file-owner">
            <div class="owner-avatar">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none"
                   stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                <circle cx="12" cy="7" r="4"/>
              </svg>
            </div>
            <%= file.owner || 'me' %>
          </div>
          <!-- Date Trashed (Figma uses "Date Trashed" column label) -->
          <div class="file-date"><%= file.trashedAt || file.uploadedAt || '—' %></div>
          <!-- Restore button (Figma: show/hide restore component) -->
          <div>
            <a href="/trash/restore/<%= file._id || file.id %>" class="btn-restore">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none"
                   stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="1 4 1 10 7 10"/>
                <path d="M3.51 15a9 9 0 1 0 .49-3.5"/>
              </svg>
              Restore
            </a>
          </div>
          <!-- Options Wrapper & Trash Menu Dropdown -->
          <div class="options-wrapper">
            <button class="options-btn toggle-options" aria-label="Options">
              <i class="fas fa-ellipsis-v"></i>
            </button>
            <%- include('../menus/trash-option-menu', { file: file }) %>
          </div>
        </div>
        <% }); %>
      <% } else { %>
        <div class="empty-state">Trash is empty.</div>
      <% } %>
    </div>
  </main>
</div>

<!-- ดึง Modal สำหรับยืนยันการทำงาน (Restore / Delete Forever) -->
<%- include('../modals/confirm-modal') %>
<%- include('../modals/storage-modal') %>

<!-- เรียกใช้ JS ของ Menu Dropdown -->
<script src="/js/toast.js"></script>
<script src="/js/menu.js"></script>
<script src="/js/storage-modal.js"></script>
</body>
</html>

