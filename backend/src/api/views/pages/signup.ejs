<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>EasyDrive - Sign Up</title>

    <link rel="stylesheet" href="css/signup.css">
</head>

<body>

    <div class="page">

        <div class="signup-container">

            <section class="form-side">

                <div class="form-box">

                    <h1>Sign Up</h1>

                    <p class="subtitle">
                        เข้าสู่ระบบจัดเก็บและแบ่งปันไฟล์
                    </p>

                    <% if (typeof error !== 'undefined' && error) { %>
                    <div class="signup-error-alert" style="background: #ffebee; color: #c62828; border: 1px solid #ef9a9a; padding: 10px 14px; border-radius: 8px; font-size: 13px; margin-bottom: 16px; display: flex; align-items: center; gap: 8px;">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                        <span><%= error %></span>
                    </div>
                    <% } %>

                    <form id="signupForm" method="POST" action="/signup">
                        <div class="input-box">
                            <div class="icon">
                                <svg viewBox="0 0 24 24">
                                    <circle cx="12" cy="8" r="4"></circle>
                                    <path d="M4 20c0-4 3.5-6 8-6s8 2 8 6"></path>
                                </svg>
                            </div>

                            <input
                                type="text"
                                name="username"
                                placeholder="กรุณากรอกชื่อผู้ใช้"
                                required
                            >
                        </div>

                        <div class="input-box">
                            <div class="icon">
                                <svg viewBox="0 0 24 24">
                                    <rect x="3" y="5" width="18" height="14" rx="2"></rect>
                                    <path d="M3 7l9 6 9-6"></path>
                                </svg>
                            </div>

                            <input
                                type="email"
                                name="email"
                                placeholder="กรุณากรอก Email"
                                required
                            >
                        </div>

                        <div class="input-box">
                            <div class="icon">
                                <svg viewBox="0 0 24 24">
                                    <rect x="5" y="10" width="14" height="10" rx="2"></rect>
                                    <path d="M8 10V7a4 4 0 0 1 8 0v3"></path>
                                </svg>
                            </div>

                            <input
                                type="password"
                                name="password"
                                id="passwordInput"
                                placeholder="กรุณากรอกรหัสผ่าน"
                                required
                            >
                            <button type="button" class="toggle-password" onclick="togglePasswordVisibility(this)">
                                <svg class="eye-open" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                                <svg class="eye-closed" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: none;"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path><line x1="1" y1="1" x2="23" y2="23"></line></svg>
                            </button>
                        </div>

                        <div class="input-box">
                            <div class="icon">
                                <svg viewBox="0 0 24 24">
                                    <path d="M12 3L20 7V11C20 16 16.5 20 12 21C7.5 20 4 16 4 11V7L12 3Z"></path>
                                    <path d="M9 12l2 2 4-4"></path>
                                </svg>
                            </div>

                            <input
                                type="password"
                                name="confirmPassword"
                                id="confirmPasswordInput"
                                placeholder="กรุณากรอกรหัสผ่านอีกครั้ง"
                                required
                            >
                            <button type="button" class="toggle-password" onclick="togglePasswordVisibility(this)">
                                <svg class="eye-open" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                                <svg class="eye-closed" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: none;"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path><line x1="1" y1="1" x2="23" y2="23"></line></svg>
                            </button>
                        </div>

                        <div class="password-rules">
                            <div class="rule" id="rule-length">
                                <span class="check">✓</span>
                                Password must contain at least 8 characters
                            </div>
                            <div class="rule" id="rule-case">
                                <span class="check">✓</span>
                                Password must contain an uppercase & lowercase letter
                            </div>
                            <div class="rule" id="rule-num-sym">
                                <span class="check">✓</span>
                                Password must contain a number & symbols
                            </div>
                        </div>

                        <div class="login-text">
                            Already have an account?
                            <a href="/signin">Sign in here</a>
                        </div>

                        <button type="submit" class="signup-btn">
                            <span>Sign Up</span>
                            <span class="arrow">→</span>
                        </button>
                    </form>
                </div>

            </section>

            <section class="visual-side">

                <img
                    src="images/easydrive-bg.png"
                    class="visual-bg"
                    alt=""
                >

                <div class="visual-content">

                    <img
                        src="images/easydrive-logo.png"
                        class="logo"
                        alt="EasyDrive"
                    >

                    <p>Simple. Secure. Easy.</p>

                    <div class="visual-badge">
                        <span class="badge-dot"></span>
                        Your files, everywhere.
                    </div>

                </div>

            </section>

        </div>

    </div>
<script src="/js/signup.js"></script>
</body>
</html>