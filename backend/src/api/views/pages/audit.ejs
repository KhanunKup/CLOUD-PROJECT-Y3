                    <input type="text" placeholder="ค้นหาผู้ใช้งาน...">
                    <div class="filter-buttons">
                        <button>ACTION ▼</button>
                        <button>LEVEL ▼</button>
                    </div>
                </div>
                
                <div class="stats-section">
                    <!-- Total Events -->
                    <div class="stat-box">
                        <div class="stat-icon-wrapper">
                            <svg viewBox="0 0 24 24" fill="#333"><path d="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 14.59L14.59 18l-2.12-2.12c-.56.34-1.2.53-1.88.53-1.93 0-3.5-1.57-3.5-3.5S8.66 9.41 10.59 9.41s3.5 1.57 3.5 3.5c0 .68-.19 1.32-.53 1.88L16 16.59zM10.59 10.91c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2z"/></svg>
                        </div>
                        <div class="stat-info">
                            <div class="stat-number text-orange">50</div>
                            <div class="stat-label">เหตุการณ์ทั้งหมด</div>
                        </div>
                    </div>
                    <!-- Warning -->
                    <div class="stat-box">
                        <div class="stat-icon-wrapper">
                            <svg viewBox="0 0 24 24" fill="#f5b041"><path d="M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z"/></svg>
                        </div>
                        <div class="stat-info">
                            <div class="stat-number text-yellow">3</div>
                            <div class="stat-label">Warning</div>
                        </div>
                    </div>
                    <!-- Critical -->
                    <div class="stat-box">
                        <div class="stat-icon-wrapper">
                            <svg viewBox="0 0 24 24" fill="#e74c3c"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/></svg>
                        </div>
                        <div class="stat-info">
                            <div class="stat-number text-red">12</div>
                            <div class="stat-label">Critical</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Data Table -->
            <div class="table-container">
                <table>
                    <thead>
                        <tr>
                            <th>ผู้ใช้</th>
                            <th>ROLE</th>
                            <th>เวลา</th>
                            <th>ระดับเหตุการณ์</th>
