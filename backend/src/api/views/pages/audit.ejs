                        </tr>
                        <!-- Row 5 -->
                        <tr>
                            <td>
                                <div class="user-cell">
                                    <div class="user-avatar"><svg viewBox="0 0 24 24"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg></div>
                                    <div class="user-name-email">
                                        <strong>Example User</strong>
                                        <span>Example@gmail.com</span>
                                    </div>
                                </div>
                            </td>
                            <td><span class="badge-role role-user">User</span></td>
                            <td>
                                <div class="datetime-cell">
                                    <span>21:45:30</span>
                                    <span>2005-08-08</span>
                                </div>
                            </td>
                            <td class="level-text level-critical">Critical</td>
                            <td><span class="badge-action action-permission">Permission</span></td>
                            <td><button class="btn-detail">ดูรายละเอียด</button></td>
                        </tr>
                        <!-- Row 6 -->
                        <tr>
                            <td>
                                <div class="user-cell">
                                    <div class="user-avatar"><svg viewBox="0 0 24 24"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg></div>
