
<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>EasyDrive - Sign In</title>
    <link rel="stylesheet" href="css/login.css">
</head>
<body>
    <main class="page">
        <div class="signup-container">
            <section class="form-side">
                <div class="form-box">
                    <div class="welcome-label">
                        <span class="welcome-icon">
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M3 8.5 12 3l9 5.5V20a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V8.5Z"></path>
                                <path d="M3 8.5 12 14l9-5.5M8 21v-5h8v5"></path>
                            </svg>
                        </span>
                        <span>
                            <strong>Hello!</strong>
                            <small>Welcome back to EasyDrive</small>
                        </span>
                    </div>

                    <h1>Sign In</h1>
                    <p class="subtitle">ยินดีต้อนรับกลับมา เข้าสู่ระบบเพื่อจัดการไฟล์ของคุณ</p>

                    <div class="input-box">
                        <div class="icon">
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <circle cx="12" cy="8" r="4"></circle>
                                <path d="M4 20c0-4 3.5-6 8-6s8 2 8 6"></path>
                            </svg>
                        </div>
                        <input type="text" name="username" placeholder="กรุณากรอกชื่อผู้ใช้หรืออีเมล" autocomplete="username">
                    </div>

                    <div class="input-box">
                        <div class="icon">
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <rect x="5" y="10" width="14" height="10" rx="2"></rect>
                                <path d="M8 10V7a4 4 0 0 1 8 0v3"></path>
                            </svg>
                        </div>
                        <input type="password" name="password" placeholder="กรุณากรอกรหัสผ่าน" autocomplete="current-password">
                    </div>

                    <div class="form-options">
                        <label class="remember-option">
                            <input type="checkbox" name="remember">
                            <span>Remember me</span>
                        </label>
                        <a href="#" class="forgot-link">Forgot password?</a>
                    </div>

                    <button type="button" class="login-btn">
                        <span>Sign In</span>
                        <span class="arrow">→</span>
                    </button>

                    <div class="signup-text">
                        Don't have an account?
                        <a href="/signup">Sign up here</a>
                    </div>
                </div>
            </section>

            <section class="visual-side">
                <img src="images/easydrive-bg.png" class="visual-bg" alt="">

                <div class="visual-content">
                    <img src="images/easydrive-logo.png" class="logo" alt="EasyDrive">
                    <p class="tagline">Simple. Secure. Easy.</p>
                    <div class="visual-badge">
                        <span class="badge-dot"></span>
                        Your files, everywhere.
                    </div>
                </div>
            </section>
        </div>
    </main>
</body>
</html>
