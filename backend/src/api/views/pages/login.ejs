
<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>EasyDrive - Sign In</title>
    <link rel="stylesheet" href="css/login.css">
</head>
<body>
    <main class="page">
        <div class="signup-container">
            <section class="form-side">
                <div class="form-box">
                    <div class="welcome-label">
                        <span class="welcome-icon">
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M3 8.5 12 3l9 5.5V20a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V8.5Z"></path>
                                <path d="M3 8.5 12 14l9-5.5M8 21v-5h8v5"></path>
                            </svg>
                        </span>
                        <span>
                            <strong>Hello!</strong>
                            <small>Welcome back to EasyDrive</small>
                        </span>
                    </div>

                    <h1>Sign In</h1>
                    <p class="subtitle">ยินดีต้อนรับกลับมา เข้าสู่ระบบเพื่อจัดการไฟล์ของคุณ</p>

                    <% if (typeof error !== 'undefined' && error) { %>
                    <div class="login-error-alert" style="background: #ffebee; color: #c62828; border: 1px solid #ef9a9a; padding: 10px 14px; border-radius: 8px; font-size: 13px; margin-bottom: 16px; display: flex; align-items: center; gap: 8px;">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                        <span><%= error %></span>
                    </div>
                    <% } %>

                    <form id="loginForm" method="POST" action="/signin">
                        <div class="input-box">
                            <div class="icon">
                                <svg viewBox="0 0 24 24" aria-hidden="true">
                                    <circle cx="12" cy="8" r="4"></circle>
                                    <path d="M4 20c0-4 3.5-6 8-6s8 2 8 6"></path>
                                </svg>
                            </div>
                            <input type="text" id="usernameInput" name="username" placeholder="กรุณากรอกชื่อผู้ใช้หรืออีเมล" autocomplete="username" required>
                        </div>

                        <div class="input-box">
                            <div class="icon">
                                <svg viewBox="0 0 24 24" aria-hidden="true">
                                    <rect x="5" y="10" width="14" height="10" rx="2"></rect>
                                    <path d="M8 10V7a4 4 0 0 1 8 0v3"></path>
                                </svg>
                            </div>
                            <input type="password" id="passwordInput" name="password" placeholder="กรุณากรอกรหัสผ่าน" autocomplete="current-password" required>
                        </div>

                        <div class="form-options">
                            <label class="remember-option">
                                <input type="checkbox" name="remember">
                                <span>Remember me</span>
                            </label>
                            <a href="/forgot-password" class="forgot-link">Forgot password?</a>
                        </div>

                        <button type="submit" class="login-btn">
                            <span>Sign In</span>
                            <span class="arrow">→</span>
                        </button>
                    </form>

                    <% if (typeof showDemoLogin !== 'undefined' && showDemoLogin) { %>
                    <!-- 1-Click Quick Demo Login Section (Local Dev Mode Only) -->
                    <div class="demo-login-section" style="margin-top: 20px; padding-top: 14px; border-top: 1px dashed #d1c7b7; text-align: center;">
                        <p style="font-size: 12px; color: #736b5e; margin-bottom: 8px; font-weight: 600;">⚡ Quick 1-Click Demo Login (ทดสอบระบบทันที):</p>
                        <div style="display: flex; gap: 8px; justify-content: center; flex-wrap: wrap;">
                            <button type="button" class="quick-demo-btn" data-user="admin@kmitl.ac.th" data-pass="admin123" style="background: #44362a; color: #fff; border: none; padding: 7px 14px; border-radius: 6px; font-size: 11px; cursor: pointer; font-weight: 600; display: flex; align-items: center; gap: 5px;">👑 Admin (Rick)</button>
                            <button type="button" class="quick-demo-btn" data-user="user@kmitl.ac.th" data-pass="user123" style="background: #846145; color: #fff; border: none; padding: 7px 14px; border-radius: 6px; font-size: 11px; cursor: pointer; font-weight: 600; display: flex; align-items: center; gap: 5px;">👤 User (Morty)</button>
                        </div>
                    </div>
                    <% } %>

                    <div class="signup-text" style="margin-top: 16px;">
                        Don't have an account?
                        <a href="/signup">Sign up here</a>
                    </div>
                </div>
            </section>

            <section class="visual-side">
                <img src="images/easydrive-bg.png" class="visual-bg" alt="">

                <div class="visual-content">
                    <img src="images/easydrive-logo.png" class="logo" alt="EasyDrive">
                    <p class="tagline">Simple. Secure. Easy.</p>
                    <div class="visual-badge">
                        <span class="badge-dot"></span>
                        Your files, everywhere.
                    </div>
                </div>
            </section>
        </div>
    </main>
    <% if (typeof showDemoLogin !== 'undefined' && showDemoLogin) { %>
    <script>
    document.querySelectorAll('.quick-demo-btn').forEach(btn => {
        btn.addEventListener('click', () => {
            const userField = document.getElementById('usernameInput');
            const passField = document.getElementById('passwordInput');
            if (userField && passField) {
                userField.value = btn.dataset.user;
                passField.value = btn.dataset.pass;
                document.getElementById('loginForm')?.submit();
            }
        });
    });
    </script>
    <% } %>
</body>
</html>
