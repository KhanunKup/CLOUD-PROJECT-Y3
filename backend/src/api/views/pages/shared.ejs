<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Shared With Me — EasyDrive</title>

  <!-- FontAwesome สำหรับไอคอน -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

  <!-- CSS สำหรับ Menu Dropdown -->
  <link rel="stylesheet" href="/css/menu.css">
  <!-- CSS โครงสร้างหลัก -->
  <link rel="stylesheet" href="/css/homepage.css">
  <!-- CSS สำหรับ Information Drawer -->
  <link rel="stylesheet" href="/css/info-drawer.css">
</head>
<body>
<div class="page-layout">

  <!-- Sidebar partial — currentPage='shared' highlights SHARED item -->
  <%- include('../partials/nav/sidebar', { currentPage: 'shared', user: typeof user !== 'undefined' ? user : null }) %>
  <div class="sidebar-spacer"></div>

  <main class="main-content">
    <div class="topbar">
      <div class="search-wrapper">
        <svg class="search-icon" width="18" height="18" viewBox="0 0 24 24"
             fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
        <input class="search-input" type="text" placeholder="Search in Drive" />
        <button type="button" class="search-clear-btn" id="searchClearBtn" aria-label="Clear search" title="Clear search" style="display: none;">&times;</button>
      </div>
      <div class="new-action-wrapper">
        <button class="btn-new" id="btnNew">+ New</button>
        <%- include('../menus/new-option-menu') %>
      </div>
    </div>

    <!-- Title Row & Tabs -->
    <div class="title-row" style="display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 15px;">
      <h1 class="page-title">SHARED</h1>
      <div class="shared-tabs">
        <button type="button" class="shared-tab-btn active" id="tabBtnSharedWithMe" data-target="sharedWithMeTable">
          <i class="fas fa-inbox"></i> Shared with me (<span id="sharedWithMeCount"><%= typeof sharedWithMe !== 'undefined' ? sharedWithMe.length : 0 %></span>)
        </button>
        <button type="button" class="shared-tab-btn" id="tabBtnSharedByMe" data-target="sharedByMeTable">
          <i class="fas fa-paper-plane"></i> Shared by me (<span id="sharedByMeCount"><%= typeof sharedByMe !== 'undefined' ? sharedByMe.length : 0 %></span>)
        </button>
      </div>
    </div>

    <!-- Tab 1: Shared With Me -->
    <div class="file-table-container shared-table-panel" id="sharedWithMeTable">
      <div class="file-table-header">
        <span class="sortable-col" data-sort="name">Name <span class="sort-icon"><i class="fas fa-sort"></i></span></span>
        <span class="sortable-col" data-sort="owner">Owner <span class="sort-icon"><i class="fas fa-sort"></i></span></span>
        <span class="sortable-col sort-active" data-sort="date">Date Uploaded <span class="sort-icon"><i class="fas fa-arrow-down"></i></span></span>
        <span></span>
      </div>

      <% if (typeof sharedWithMe !== 'undefined' && sharedWithMe && sharedWithMe.length > 0) { %>
        <% sharedWithMe.forEach(function(file) { %>
        <div class="file-row"
             data-id="<%= file.id %>"
             data-name="<%= file.name %>"
             data-type="<%= file.type || 'file' %>"
             data-category="<%= file.category || 'other' %>"
             data-size="<%= file.size || '' %>"
             data-owner="<%= file.owner || 'unknown' %>"
             data-is-owner="<%= file.isOwner ? 'true' : 'false' %>"
             data-date="<%= file.createdAt || file.uploadDate || '' %>"
             data-tags="<%= (file.tags || []).join(',') %>"
             data-share-url="<%= file.shareUrl || '' %>"
             data-permission="<%= file.permission || 'can view' %>"
             data-can-edit="<%= (file.permission === 'can edit' || file.canEdit) ? 'true' : 'false' %>">
          <div class="file-name">
            <% if (file.type === 'folder') { %>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                   stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/>
              </svg>
            <% } else { %>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                   stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                <polyline points="14 2 14 8 20 8"/>
              </svg>
            <% } %>
            <%= file.name %>
          </div>
          <div class="file-owner">
            <div class="owner-avatar">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none"
                   stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                <circle cx="12" cy="7" r="4"/>
              </svg>
            </div>
            <%= file.owner || 'unknown' %>
          </div>
          <div class="file-date"><%= file.uploadDate || file.uploadedAt || '—' %></div>
          <div class="options-wrapper">
            <button class="options-btn toggle-options" aria-label="Options"><i class="fas fa-ellipsis-v"></i></button>
            <%- include('../menus/shared-with-me-menu', { file: file }) %>
          </div>
        </div>
        <% }); %>
      <% } else { %>
        <div class="empty-state">No files have been shared with you yet.</div>
      <% } %>
    </div>

    <!-- Tab 2: Shared By Me -->
    <div class="file-table-container shared-table-panel" id="sharedByMeTable" style="display: none;">
      <div class="file-table-header shared-by-me-header">
        <span class="sortable-col" data-sort="name">Name <span class="sort-icon"><i class="fas fa-sort"></i></span></span>
        <span>Share Status &amp; Limits</span>
        <span class="sortable-col sort-active" data-sort="date">Date Shared <span class="sort-icon"><i class="fas fa-arrow-down"></i></span></span>
        <span></span>
      </div>

      <% if (typeof sharedByMe !== 'undefined' && sharedByMe && sharedByMe.length > 0) { %>
        <% sharedByMe.forEach(function(file) { %>
        <div class="file-row" id="row-share-<%= file.shareId %>"
             data-id="<%= file.id %>"
             data-name="<%= file.name %>"
             data-type="<%= file.type || 'file' %>"
             data-category="<%= file.category || 'other' %>"
             data-size="<%= file.size || '' %>"
             data-owner="me"
             data-is-owner="true"
             data-date="<%= file.createdAt || file.uploadDate || '' %>"
             data-tags="<%= (file.tags || []).join(',') %>"
             data-share-url="<%= file.shareUrl || '' %>"
             data-permission="<%= file.permission || 'can view' %>"
             data-can-edit="<%= (file.permission === 'can edit' || file.canEdit) ? 'true' : 'false' %>">
          <div class="file-name">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
              <polyline points="14 2 14 8 20 8"/>
            </svg>
            <span><%= file.name %></span>
          </div>
          <div class="file-share-badges open-share-modal" 
               style="cursor: pointer;"
               title="Click to edit share settings"
               data-id="<%= file.id %>" 
               data-share-id="<%= file.shareId %>" 
               data-filename="<%= file.name %>" 
               data-mode="edit"
               data-expire-hours="<%= file.expireHours || '24' %>"
               data-max-downloads="<%= file.maxDownloads !== undefined ? file.maxDownloads : '0' %>"
               data-has-password="<%= file.hasPassword ? 'true' : 'false' %>"
               data-share-url="<%= file.shareUrl || '' %>"
               data-access="<%= encodeURIComponent(JSON.stringify(file.accessList || [])) %>">
            <% if (file.hasPassword) { %>
              <span class="badge-share-status badge-pw" title="Password Protected"><i class="fas fa-lock"></i> Password</span>
            <% } else if (file.shareUrl) { %>
              <span class="badge-share-status badge-public" title="Public Link"><i class="fas fa-globe"></i> Public</span>
            <% } else { %>
              <span class="badge-share-status badge-public" style="background: rgba(107, 115, 92, 0.25); color: #555e46;" title="Shared with collaborators"><i class="fas fa-users"></i> Shared</span>
            <% } %>

            <% if (file.remainingHours !== null) { %>
              <span class="badge-share-status badge-ttl" title="Time Remaining"><i class="fas fa-clock"></i> <%= file.remainingHours %>h left</span>
            <% } else { %>
              <span class="badge-share-status badge-ttl-inf" title="No Expiration"><i class="fas fa-infinity"></i> No Expiry</span>
            <% } %>

            <% if (file.maxDownloads > 0) { %>
              <span class="badge-share-status badge-dl-limit" title="Downloads Left"><i class="fas fa-fire"></i> <%= file.downloadsLeft %> DL left</span>
            <% } else { %>
              <span class="badge-share-status badge-dl-unlimited" title="Downloads"><i class="fas fa-download"></i> Unlimited</span>
            <% } %>
          </div>
          <div class="file-date"><%= file.uploadDate || '—' %></div>
          <div class="options-wrapper">
            <button class="options-btn toggle-options" aria-label="Options"><i class="fas fa-ellipsis-v"></i></button>
            <%- include('../menus/shared-by-me-menu', { file: file }) %>
          </div>
        </div>
        <% }); %>
      <% } else { %>
        <div class="empty-state">You haven't shared any files yet. Share files from My Drive to see them here.</div>
      <% } %>
    </div>
  </main>
</div>

<!-- ดึง Modal ต่างๆ มาใช้ตรงนี้ -->
<%- include('../modals/share-modal') %>
<%- include('../modals/manage-access-modal') %>
<%- include('../modals/rename-modal') %>
<%- include('../modals/new-folder-modal') %>
<%- include('../modals/upload-modal') %>
<%- include('../modals/confirm-modal') %>
<%- include('../modals/preview-modal') %>
<%- include('../modals/info-drawer') %>
<%- include('../modals/storage-modal') %>

<!-- เรียกใช้ JS ของ Menu Dropdown -->
<script src="/js/toast.js"></script>
<script src="/js/menu.js?v=<%= Date.now() %>"></script>
<script src="/js/info-drawer.js"></script>
<script src="/js/storage-modal.js"></script>
</body>
</html>