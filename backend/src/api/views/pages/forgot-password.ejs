<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Forgot Password — EasyDrive</title>
    <link rel="stylesheet" href="/css/login.css">
    <style>
        .form-box h1 { font-size: 26px; margin-bottom: 6px; }
        .back-link {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            color: #a65b45;
            text-decoration: none;
            font-size: 13px;
            font-weight: 500;
            margin-bottom: 22px;
        }
        .back-link:hover { text-decoration: underline; }
        .back-link svg { width: 15px; height: 15px; }
        .success-alert {
            background: #e8f5e9;
            color: #2e7d32;
            border: 1px solid #a5d6a7;
            padding: 10px 14px;
            border-radius: 8px;
            font-size: 13px;
            margin-bottom: 16px;
            display: flex;
            flex-direction: column;
            gap: 8px;
        }
        .mock-reset-box {
            background: #fff8e1;
            border: 1px dashed #f9a825;
            border-radius: 8px;
            padding: 10px 12px;
            font-size: 12px;
            color: #5d4037;
            margin-top: 6px;
        }
        .mock-reset-box strong { display: block; margin-bottom: 4px; color: #e65100; }
        .mock-reset-box a { color: #1565c0; word-break: break-all; font-weight: 600; }
        .error-alert {
            background: #ffebee;
            color: #c62828;
            border: 1px solid #ef9a9a;
            padding: 10px 14px;
            border-radius: 8px;
            font-size: 13px;
            margin-bottom: 16px;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .helper-text {
            font-size: 13px;
            color: #7a6a5a;
            margin-bottom: 20px;
            line-height: 1.55;
        }
        .input-box input { width: 100%; }
    </style>
</head>
<body>
    <main class="page">
        <div class="signup-container">
            <section class="form-side">
                <div class="form-box">

                    <a href="/signin" class="back-link">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="15 18 9 12 15 6"/>
                        </svg>
                        Back to Sign In
                    </a>

                    <h1>Forgot Password?</h1>
                    <p class="helper-text">
                        Enter the email address associated with your account and we'll send you a reset link.
                    </p>

                    <% if (typeof error !== 'undefined' && error) { %>
                    <div class="error-alert">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                        <span><%= error %></span>
                    </div>
                    <% } %>

                    <% if (typeof success !== 'undefined' && success) { %>
                    <div class="success-alert">
                        <div style="display:flex;align-items:center;gap:8px;">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                            <span><%= success %></span>
                        </div>
                        <% if (typeof mockResetUrl !== 'undefined' && mockResetUrl) { %>
                        <div class="mock-reset-box" style="background: rgba(46, 125, 50, 0.08); border: 1px solid rgba(46, 125, 50, 0.25); border-radius: 8px; padding: 12px 14px; margin-top: 10px;">
                            <strong style="color: #2e7d32; display: flex; align-items: center; gap: 6px; font-size: 13px;">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                                Password Reset Link Ready
                            </strong>
                            <p style="font-size: 12px; margin: 4px 0 10px 0; color: #554335;">Due to AWS Learner Lab email restrictions, your secure reset link is available directly:</p>
                            <a href="<%= mockResetUrl %>" style="display: inline-flex; align-items: center; gap: 6px; background: #2e7d32; color: #fff; padding: 7px 14px; border-radius: 6px; text-decoration: none; font-weight: 600; font-size: 12px;">Reset Password Now &rarr;</a>
                        </div>
                        <% } %>
                    </div>
                    <% } %>

                    <% if (!(typeof success !== 'undefined' && success)) { %>
                    <form method="POST" action="/forgot-password">
                        <div class="input-box">
                            <div class="icon">
                                <svg viewBox="0 0 24 24" aria-hidden="true">
                                    <rect x="3" y="5" width="18" height="14" rx="2"></rect>
                                    <path d="M3 7l9 6 9-6"></path>
                                </svg>
                            </div>
                            <input
                                type="email"
                                name="email"
                                placeholder="Enter your email address"
                                autocomplete="email"
                                required
                            >
                        </div>

                        <button type="submit" class="login-btn">
                            <span>Send Reset Link</span>
                            <span class="arrow">→</span>
                        </button>
                    </form>
                    <% } %>

                    <div class="signup-text" style="margin-top: 20px;">
                        Remember your password?
                        <a href="/signin">Sign in</a>
                    </div>
                </div>
            </section>

            <section class="visual-side">
                <img src="/images/easydrive-bg.png" class="visual-bg" alt="">
                <div class="visual-content">
                    <img src="/images/easydrive-logo.png" class="logo" alt="EasyDrive">
                    <p class="tagline">Simple. Secure. Easy.</p>
                    <div class="visual-badge">
                        <span class="badge-dot"></span>
                        Your files, everywhere.
                    </div>
                </div>
            </section>
        </div>
    </main>
</body>
</html>

