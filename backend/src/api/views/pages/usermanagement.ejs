<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>EASYDRIVE - User Management</title>
    <style>
        @font-face {
        font-family: 'EnglishFont'; /* ตั้งชื่อฟอนต์ตามต้องการ */
        src: url('/fonts/Kanit-Bold.ttf') format('truetype'); 
        /* หมายเหตุ: ไม่ต้องใส่ /public นำหน้า เพราะใน server.js เราตั้ง static folder ไว้แล้ว */
        }

        @font-face {
            font-family: 'ThaiFont'; /* ตั้งชื่อฟอนต์ตามต้องการ */
            src: url('/fonts/Outfit-VariableFont_wght.ttf') format('truetype'); 
            /* หมายเหตุ: ไม่ต้องใส่ /public นำหน้า เพราะใน server.js เราตั้ง static folder ไว้แล้ว */
        }
        body {
            margin:0%;
            font-family: 'EnglishFont', 'ThaiFont', sans-serif;
        }

        /* --- พื้นที่เนื้อหาหลัก (Main Container) --- */
        .main-container {
            flex: 1;
            padding: 40px;
            display: flex;
            justify-content: center;
        }

        .content-card {
            background-color: #f2ede7; /* สีพื้นหลังของการ์ดหลัก */
            border-radius: 20px;
            width: 100%;
            max-width: 1200px;
            padding: 30px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.05);
        }

        /* ส่วนหัวของการ์ด (Title Area) */
        .card-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            border-bottom: 2px solid #e2d5ca;
            padding-bottom: 20px;
            margin-bottom: 20px;
        }
        .page-title h1 {
            font-size: 2.2rem;
            color: #222;
            margin-bottom: 5px;
        }
        .page-title p {
            color: #555;
            font-size: 1rem;
        }
        .header-icon svg {
            width: 50px;
            height: 50px;
            fill: #333;
        }

        /* แถบเครื่องมือจัดการ (Toolbar: Search & Stats) */
        .toolbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }

        .filter-section {
            display: flex;
            flex-direction: column;
            gap: 10px;
            width: 40%;
        }
        .filter-section input {
            padding: 12px 20px;
            border-radius: 10px;
            border: 1px solid #d1bdae;
            background-color: #fff;
            width: 100%;
            font-size: 1rem;
        }
        .filter-buttons {
            display: flex;
            gap: 10px;
        }
        .filter-buttons button {
            padding: 6px 15px;
            border-radius: 20px;
            border: 1px solid #ccc;
            background-color: #fff;
            cursor: pointer;
            font-size: 0.85rem;
            color: #555;
            display: flex;
            align-items: center;
            gap: 5px;
        }

        .stats-section {
            display: flex;
            gap: 15px;
        }
        .stat-box {
            background-color: #fff;
            border-radius: 15px;
            padding: 15px 25px;
            display: flex;
            align-items: center;
            gap: 15px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.03);
            min-width: 150px;
        }
        .stat-box svg { width: 30px; height: 30px; fill: #333; }
        .stat-info { text-align: center; }
        .stat-number { font-size: 1.5rem; font-weight: bold; line-height: 1; }
        .stat-label { font-size: 0.75rem; color: #666; margin-top: 5px; }

        .text-orange { color: #f26b21; }
        .text-purple { color: #9c27b0; }
        .text-green { color: #4caf50; }

        /* --- ตารางข้อมูลผู้ใช้ (Data Table) --- */
        .table-container {
            background-color: #fff;
            border-radius: 15px;
            overflow: hidden;
        }
        table {
            width: 100%;
            border-collapse: collapse;
        }
        th, td {
            padding: 15px 20px;
            text-align: left;
            border-bottom: 1px solid #f0f0f0;
        }
        th {
            background-color: #fcfbfa;
            color: #555;
            font-weight: bold;
            font-size: 0.9rem;
        }
        
        .user-cell {
            display: flex;
            align-items: center;
            gap: 15px;
        }
        .user-avatar {
            width: 40px;
            height: 40px;
            background-color: #e0f0ff;
            border-radius: 50%;
            display: flex;
            justify-content: center;
            align-items: center;
        }
        .user-avatar svg { width: 20px; height: 20px; fill: #2196f3; }
        .user-name-email { display: flex; flex-direction: column; }
        .user-name-email strong { color: #222; font-size: 0.95rem;}
        .user-name-email span { color: #888; font-size: 0.8rem;}

        /* ป้ายสถานะ Role */
        .badge {
            padding: 5px 15px;
            border-radius: 20px;
            font-size: 0.85rem;
            font-weight: bold;
            border: 1px solid #ddd;
            background-color: #fff;
            display: inline-block;
            text-align: center;
            min-width: 70px;
        }
        .badge-admin { color: #f44336; }
        .badge-user { color: #333; }

        .date-text { color: #222; font-weight: bold; font-size: 0.9rem; }

        /* ปุ่ม Action (แก้ไข/ลบ) */
        .action-btns {
            display: flex;
            gap: 10px;
        }
        .btn-edit, .btn-delete {
            padding: 6px 20px;
            border-radius: 20px;
            border: none;
            color: white;
            cursor: pointer;
            font-size: 0.85rem;
        }
        .btn-edit { background-color: #2196f3; }
        .btn-delete { background-color: #f44336; }

        /* --- แบ่งหน้า (Pagination) --- */
        .pagination {
            display: flex;
            justify-content: flex-end;
            align-items: center;
            padding: 20px 0 0 0;
            gap: 5px;
        }
        .page-btn, .page-num {
            padding: 8px 15px;
            border-radius: 20px;
            background-color: #fff;
            border: 1px solid #ddd;
            cursor: pointer;
            font-size: 0.9rem;
            color: #333;
        }
        .page-num.active {
            background-color: #e0e0e0;
            font-weight: bold;
        }

    </style>
</head>
<body>

    <!-- แถบเมนูด้านบน -->
    <div class="nav">
        <%- include('../partials/nav/topbar-admin.ejs') %>
    </div>

    <!-- พื้นที่เนื้อหาหลัก -->
    <main class="main-container">
        <div class="content-card">
            
            <!-- ส่วนหัวของการ์ด -->
            <div class="card-header">
                <div class="page-title">
                    <h1>User Management</h1>
                    <p>จัดการผู้ใช้งานทั้งหมดในระบบ</p>
                </div>
                <div class="header-icon">
                    <svg viewBox="0 0 24 24"><path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"/></svg>
                </div>
            </div>

            <!-- แถบเครื่องมือและสถิติ -->
            <div class="toolbar">
                <div class="filter-section">
                    <input type="text" placeholder="ค้นหาผู้ใช้งาน...">
                    <div class="filter-buttons">
                        <button>ROLE ▼</button>
                        <button>Status ▼</button>
                    </div>
                </div>
                
                <div class="stats-section">
                    <div class="stat-box">
                        <svg viewBox="0 0 24 24"><path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"/></svg>
                        <div class="stat-info">
                            <div class="stat-number text-orange">50</div>
                            <div class="stat-label">ผู้ใช้ทั้งหมด</div>
                        </div>
                    </div>
                    <div class="stat-box">
                        <svg viewBox="0 0 24 24"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 10.99h7c-.53 4.12-3.28 7.79-7 8.94V12H5V6.3l7-3.11v8.8z"/></svg>
                        <div class="stat-info">
                            <div class="stat-number text-purple">3</div>
                            <div class="stat-label">Admins</div>
                        </div>
                    </div>
                    <div class="stat-box">
                        <svg viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zM4 12c0-.61.08-1.21.21-1.78L8.99 15v1c0 1.1.9 2 2 2v1.93C7.06 19.43 4 16.05 4 12zm13.89 5.4c-.26-.81-1-1.4-1.9-1.4h-1v-3c0-.55-.45-1-1-1h-6v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41C17.92 5.77 20 8.65 20 12c0 2.08-.81 3.98-2.11 5.4z"/></svg>
                        <div class="stat-info">
                            <div class="stat-number text-green">12</div>
                            <div class="stat-label">ออนไลน์</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ตารางข้อมูล -->
            <div class="table-container">
                <table>
                    <thead>
                        <tr>
                            <th>ผู้ใช้</th>
                            <th>ROLE</th>
                            <th>สร้างเมื่อ</th>
                            <th>เข้าสู่ระบบล่าสุด</th>
                            <th>จัดการ</th>
                        </tr>
                    </thead>
                    <tbody>
                        <!-- แถวข้อมูล (วนลูปสร้างหลายๆ แถวได้) -->
                        <tr>
                            <td>
                                <div class="user-cell">
                                    <div class="user-avatar"><svg viewBox="0 0 24 24"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg></div>
                                    <div class="user-name-email">
                                        <strong>Example User</strong>
                                        <span>Example@gmail.com</span>
                                    </div>
                                </div>
                            </td>
                            <td><span class="badge badge-user">User</span></td>
                            <td class="date-text">2005-08-08</td>
                            <td class="date-text">2026-09-09</td>
                            <td>
                                <div class="action-btns">
                                    <button class="btn-edit">แก้ไข</button>
                                    <button class="btn-delete">ลบ</button>
                                </div>
                            </td>
                        </tr>
                        <tr>
                            <td>
                                <div class="user-cell">
                                    <div class="user-avatar"><svg viewBox="0 0 24 24"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg></div>
                                    <div class="user-name-email">
                                        <strong>Example User</strong>
                                        <span>Example@gmail.com</span>
                                    </div>
                                </div>
                            </td>
                            <td><span class="badge badge-admin">Admin</span></td>
                            <td class="date-text">2005-08-08</td>
                            <td class="date-text">2026-09-09</td>
                            <td>
                                <div class="action-btns">
                                    <button class="btn-edit">แก้ไข</button>
                                    <button class="btn-delete">ลบ</button>
                                </div>
                            </td>
                        </tr>
                        <!-- สิ้นสุดตัวอย่างแถว (ก็อปปี้เพิ่มได้) -->
                    </tbody>
                </table>
            </div>

            <!-- การแบ่งหน้า -->
            <div class="pagination">
                <button class="page-btn">ก่อนหน้า</button>
                <button class="page-num active">1</button>
                <button class="page-num">2</button>
                <button class="page-num">3</button>
                <button class="page-btn">ถัดไป</button>
            </div>

        </div>
    </main>

</body>
</html>