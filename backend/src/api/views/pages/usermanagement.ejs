<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>EASYDRIVE - User Management</title>
    <style>
        @font-face {
        font-family: 'EnglishFont'; /* ตั้งชื่อฟอนต์ตามต้องการ */
        src: url('/fonts/Kanit-Bold.ttf') format('truetype'); 
        /* หมายเหตุ: ไม่ต้องใส่ /public นำหน้า เพราะใน server.js เราตั้ง static folder ไว้แล้ว */
        }

        @font-face {
            font-family: 'ThaiFont'; /* ตั้งชื่อฟอนต์ตามต้องการ */
            src: url('/fonts/Outfit-VariableFont_wght.ttf') format('truetype'); 
            /* หมายเหตุ: ไม่ต้องใส่ /public นำหน้า เพราะใน server.js เราตั้ง static folder ไว้แล้ว */
        }
        body {
            margin:0%;
            font-family: 'EnglishFont', 'ThaiFont', sans-serif;
        }

        /* --- พื้นที่เนื้อหาหลัก (Main Container) --- */
        .main-container {
            flex: 1;
            padding: 40px;
            display: flex;
            justify-content: center;
        }

        .content-card {
            background-color: #f2ede7; /* สีพื้นหลังของการ์ดหลัก */
            border-radius: 20px;
            width: 100%;
            max-width: 1200px;
            padding: 30px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.05);
        }

        /* ส่วนหัวของการ์ด (Title Area) */
        .card-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            border-bottom: 2px solid #e2d5ca;
            padding-bottom: 20px;
            margin-bottom: 20px;
        }
        .page-title h1 {
            font-size: 2.2rem;
            color: #222;
            margin-bottom: 5px;
        }
        .page-title p {
            color: #555;
            font-size: 1rem;
        }
        .header-icon svg {
            width: 50px;
            height: 50px;
            fill: #333;
        }

        /* แถบเครื่องมือจัดการ (Toolbar: Search & Stats) */
        .toolbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }

        .filter-section {
            display: flex;
            flex-direction: column;
            gap: 10px;
            width: 40%;
        }
        .filter-section input {
            padding: 12px 20px;
            border-radius: 10px;
            border: 1px solid #d1bdae;
            background-color: #fff;
            width: 100%;
            font-size: 1rem;
        }
        .filter-buttons {
            display: flex;
            gap: 10px;
        }
        .filter-buttons button {
            padding: 6px 15px;
            border-radius: 20px;
            border: 1px solid #ccc;
            background-color: #fff;
            cursor: pointer;
            font-size: 0.85rem;
            color: #555;
            display: flex;
            align-items: center;
            gap: 5px;
        }

        .stats-section {
            display: flex;
            gap: 15px;
        }
        .stat-box {
            background-color: #fff;
            border-radius: 15px;
            padding: 15px 25px;
            display: flex;
            align-items: center;
            gap: 15px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.03);
            min-width: 150px;
        }
        .stat-box svg { width: 30px; height: 30px; fill: #333; }
        .stat-info { text-align: center; }
        .stat-number { font-size: 1.5rem; font-weight: bold; line-height: 1; }
        .stat-label { font-size: 0.75rem; color: #666; margin-top: 5px; }

        .text-orange { color: #f26b21; }
        .text-purple { color: #9c27b0; }
        .text-green { color: #4caf50; }

        /* --- ตารางข้อมูลผู้ใช้ (Data Table) --- */
        .table-container {
            background-color: #fff;
            border-radius: 15px;
            overflow: hidden;
        }
        table {
            width: 100%;
            border-collapse: collapse;
        }
        th, td {
            padding: 15px 20px;
            text-align: left;
            border-bottom: 1px solid #f0f0f0;
        }
        th {
            background-color: #fcfbfa;
            color: #555;
            font-weight: bold;
            font-size: 0.9rem;
        }
        
        .user-cell {
            display: flex;
            align-items: center;
            gap: 15px;
        }
        .user-avatar {
            width: 40px;
            height: 40px;
            background-color: #e0f0ff;
            border-radius: 50%;
            display: flex;
            justify-content: center;
            align-items: center;
        }
        .user-avatar svg { width: 20px; height: 20px; fill: #2196f3; }
        .user-name-email { display: flex; flex-direction: column; }
        .user-name-email strong { color: #222; font-size: 0.95rem;}
        .user-name-email span { color: #888; font-size: 0.8rem;}

        /* ป้ายสถานะ Role */
        .badge {
            padding: 5px 15px;
            border-radius: 20px;
            font-size: 0.85rem;
            font-weight: bold;
            border: 1px solid #ddd;
            background-color: #fff;
            display: inline-block;
            text-align: center;
            min-width: 70px;
        }
        .badge-admin { color: #f44336; }
        .badge-user { color: #333; }

        .date-text { color: #222; font-weight: bold; font-size: 0.9rem; }

        /* ปุ่ม Action (แก้ไข/ลบ) */
        .action-btns {
            display: flex;
            gap: 10px;
        }
        .btn-edit, .btn-delete {
            padding: 6px 20px;
            border-radius: 20px;
            border: none;
            color: white;
            cursor: pointer;
            font-size: 0.85rem;
        }
        .btn-edit { background-color: #2196f3; }
        .btn-delete { background-color: #f44336; }

        /* --- แบ่งหน้า (Pagination) --- */
        .pagination {
            display: flex;
            justify-content: flex-end;
            align-items: center;
            padding: 20px 0 0 0;
            gap: 5px;
        }
        .page-btn, .page-num {
            padding: 8px 15px;
            border-radius: 20px;
            background-color: #fff;
            border: 1px solid #ddd;
            cursor: pointer;
            font-size: 0.9rem;
            color: #333;
        }
        .page-num.active {
            background-color: #e0e0e0;
            font-weight: bold;
        }

    </style>
</head>
<body>

    <!-- แถบเมนูด้านบน -->
    <div class="nav">
        <%- include('../partials/nav/topbar-admin.ejs') %>
    </div>

    <!-- พื้นที่เนื้อหาหลัก -->
    <main class="main-container">
        <div class="content-card">
            
            <!-- ส่วนหัวของการ์ด -->
            <div class="card-header">
                <div class="page-title">
                    <h1>User Management</h1>
                    <p>จัดการผู้ใช้งานทั้งหมดในระบบ</p>
                </div>
                <div class="header-icon">
                    <svg viewBox="0 0 24 24"><path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"/></svg>
                </div>
            </div>

            <!-- แถบเครื่องมือและสถิติ -->
            <div class="toolbar">
                <div class="filter-section">
                    <input type="text" placeholder="ค้นหาผู้ใช้งาน...">
                    <div class="filter-buttons">
                        <button>ROLE ▼</button>
                        <button>Status ▼</button>
                    </div>
                </div>
                
                <div class="stats-section">
                    <div class="stat-box">
                        <svg viewBox="0 0 24 24"><path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"/></svg>
                        <div class="stat-info">
                            <div class="stat-number text-orange" id="totalUsersStat"><%= typeof totalUsers !== 'undefined' ? totalUsers : 0 %></div>
                            <div class="stat-label">ผู้ใช้ทั้งหมด</div>
                        </div>
                    </div>
                    <div class="stat-box">
                        <svg viewBox="0 0 24 24"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 10.99h7c-.53 4.12-3.28 7.79-7 8.94V12H5V6.3l7-3.11v8.8z"/></svg>
                        <div class="stat-info">
                            <div class="stat-number text-purple" id="adminsStat"><%= typeof adminCount !== 'undefined' ? adminCount : 0 %></div>
                            <div class="stat-label">Admins</div>
                        </div>
                    </div>
                    <div class="stat-box">
                        <svg viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zM4 12c0-.61.08-1.21.21-1.78L8.99 15v1c0 1.1.9 2 2 2v1.93C7.06 19.43 4 16.05 4 12zm13.89 5.4c-.26-.81-1-1.4-1.9-1.4h-1v-3c0-.55-.45-1-1-1h-6v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41C17.92 5.77 20 8.65 20 12c0 2.08-.81 3.98-2.11 5.4z"/></svg>
                        <div class="stat-info">
                            <div class="stat-number text-green" id="normalUsersStat"><%= typeof userCount !== 'undefined' ? userCount : 0 %></div>
                            <div class="stat-label">Users ทั่วไป</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ตารางข้อมูล -->
            <div class="table-container">
                <table>
                    <thead>
                        <tr>
                            <th>ผู้ใช้</th>
                            <th>ROLE</th>
                            <th>สร้างเมื่อ</th>
                            <th>พื้นที่ใช้งาน</th>
                            <th>จัดการ</th>
                        </tr>
                    </thead>
                    <tbody id="userTableBody">
                        <% if (typeof users !== 'undefined' && users && users.length > 0) { %>
                            <% users.forEach(function(u) { %>
                                <tr class="user-row" data-id="<%= u.user_id %>" data-name="<%= (u.name || '').toLowerCase() %>" data-email="<%= (u.email || '').toLowerCase() %>" data-role="<%= u.role %>">
                                    <td>
                                        <div class="user-cell">
                                            <div class="user-avatar"><svg viewBox="0 0 24 24"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg></div>
                                            <div class="user-name-email">
                                                <strong><%= u.name %></strong>
                                                <span><%= u.email %></span>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge <%= u.role === 'admin' ? 'badge-admin' : 'badge-user' %>"><%= u.role === 'admin' ? 'Admin' : 'User' %></span>
                                    </td>
                                    <td class="date-text"><%= new Date(u.created_at).toLocaleDateString('en-GB') %></td>
                                    <td class="date-text"><%= u.storageFormatted || '0 B' %></td>
                                    <td>
                                        <div class="action-btns">
                                            <button type="button" class="btn-edit open-edit-user-btn" 
                                                    data-id="<%= u.user_id %>" 
                                                    data-name="<%= u.name %>" 
                                                    data-role="<%= u.role %>" 
                                                    data-quota="<%= u.quota %>">แก้ไข</button>
                                            <% if (typeof user !== 'undefined' && user && user.user_id === u.user_id) { %>
                                                <button type="button" class="btn-delete" style="opacity: 0.4; cursor: not-allowed;" title="ไม่สามารถลบบัญชีตัวเองได้" disabled>ลบ</button>
                                            <% } else { %>
                                                <button type="button" class="btn-delete delete-user-btn" data-id="<%= u.user_id %>" data-name="<%= u.name %>">ลบ</button>
                                            <% } %>
                                        </div>
                                    </td>
                                </tr>
                            <% }); %>
                        <% } else { %>
                            <tr>
                                <td colspan="5" style="text-align: center; padding: 30px; color: #888;">ไม่พบข้อมูลผู้ใช้งาน</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>

            <!-- การแบ่งหน้า -->
            <div class="pagination">
                <span id="showingCount" style="margin-right: auto; font-size: 0.85rem; color: #777;">
                    แสดง <%= typeof users !== 'undefined' ? users.length : 0 %> ผู้ใช้
                </span>
                <button class="page-btn">ก่อนหน้า</button>
                <button class="page-num active">1</button>
                <button class="page-btn">ถัดไป</button>
            </div>

        </div>
    </main>

    <!-- Modal แก้ไขข้อมูลผู้ใช้ -->
    <div id="editUserModal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 1000; align-items: center; justify-content: center;">
        <div style="background: #fff; width: 420px; border-radius: 16px; padding: 25px; box-shadow: 0 10px 30px rgba(0,0,0,0.2);">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
                <h3 style="margin: 0; color: #222;" id="editModalTitle">แก้ไขสิทธิ์และโควตาผู้ใช้</h3>
                <button type="button" id="closeEditModalBtn" style="background: none; border: none; font-size: 20px; cursor: pointer; color: #888;">&times;</button>
            </div>
            
            <form id="editUserForm">
                <input type="hidden" id="editUserId">
                
                <div style="margin-bottom: 16px;">
                    <label style="display: block; font-size: 0.85rem; font-weight: bold; color: #555; margin-bottom: 6px;">ชื่อผู้ใช้:</label>
                    <input type="text" id="editUserName" style="width: 100%; padding: 10px 14px; border: 1px solid #ddd; border-radius: 8px; box-sizing: border-box; background: #f9f9f9;" readonly>
                </div>

                <div style="margin-bottom: 16px;">
                    <label style="display: block; font-size: 0.85rem; font-weight: bold; color: #555; margin-bottom: 6px;">Role (สิทธิ์ผู้ใช้):</label>
                    <select id="editUserRole" style="width: 100%; padding: 10px 14px; border: 1.5px solid #d1bdae; border-radius: 8px; box-sizing: border-box; font-size: 0.95rem; outline: none;">
                        <option value="user">User (ผู้ใช้ทั่วไป)</option>
                        <option value="admin">Admin (ผู้ดูแลระบบ)</option>
                    </select>
                </div>

                <div style="margin-bottom: 24px;">
                    <label style="display: block; font-size: 0.85rem; font-weight: bold; color: #555; margin-bottom: 6px;">Storage Quota (โควตาพื้นที่):</label>
                    <select id="editUserQuota" style="width: 100%; padding: 10px 14px; border: 1.5px solid #d1bdae; border-radius: 8px; box-sizing: border-box; font-size: 0.95rem; outline: none;">
                        <option value="5368709120">5 GB</option>
                        <option value="10737418240">10 GB (Default)</option>
                        <option value="21474836480">20 GB</option>
                        <option value="53687091200">50 GB</option>
                    </select>
                </div>

                <div style="display: flex; gap: 10px; justify-content: flex-end;">
                    <button type="button" id="cancelEditBtn" style="padding: 10px 20px; border-radius: 20px; border: 1px solid #ccc; background: #fff; cursor: pointer; font-weight: 600;">ยกเลิก</button>
                    <button type="submit" id="saveEditBtn" style="padding: 10px 24px; border-radius: 20px; border: none; background: #2196f3; color: white; cursor: pointer; font-weight: bold;">บันทึกการเปลี่ยนแปลง</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Scripts: Toast, Realtime search, Edit & Delete -->
    <script src="/js/toast.js"></script>
    <script>
    document.addEventListener('DOMContentLoaded', () => {
        // 1. Search Filter
        const searchInput = document.querySelector('.filter-section input');
        const roleButtons = document.querySelectorAll('.filter-buttons button');
        const userRows = document.querySelectorAll('.user-row');

        let currentRoleFilter = 'all';

        function filterUsers() {
            const query = searchInput ? searchInput.value.toLowerCase().trim() : '';
            let visibleCount = 0;

            userRows.forEach(row => {
                const name = row.dataset.name || '';
                const email = row.dataset.email || '';
                const role = row.dataset.role || '';

                const matchesQuery = !query || name.includes(query) || email.includes(query);
                const matchesRole = currentRoleFilter === 'all' || role === currentRoleFilter;

                if (matchesQuery && matchesRole) {
                    row.style.display = '';
                    visibleCount++;
                } else {
                    row.style.display = 'none';
                }
            });

            const countEl = document.getElementById('showingCount');
            if (countEl) countEl.textContent = `แสดง ${visibleCount} ผู้ใช้`;
        }

        if (searchInput) {
            searchInput.addEventListener('input', filterUsers);
        }

        // 2. Role Toggle Filter (Cycle through All -> Admin -> User -> All)
        const roleBtn = roleButtons[0];
        if (roleBtn) {
            roleBtn.addEventListener('click', () => {
                if (currentRoleFilter === 'all') {
                    currentRoleFilter = 'admin';
                    roleBtn.textContent = 'ROLE: Admin ▼';
                } else if (currentRoleFilter === 'admin') {
                    currentRoleFilter = 'user';
                    roleBtn.textContent = 'ROLE: User ▼';
                } else {
                    currentRoleFilter = 'all';
                    roleBtn.textContent = 'ROLE: All ▼';
                }
                filterUsers();
            });
        }

        // 3. Edit User Modal Logic
        const editModal = document.getElementById('editUserModal');
        const editForm = document.getElementById('editUserForm');
        const editUserId = document.getElementById('editUserId');
        const editUserName = document.getElementById('editUserName');
        const editUserRole = document.getElementById('editUserRole');
        const editUserQuota = document.getElementById('editUserQuota');
        const closeEditBtn = document.getElementById('closeEditModalBtn');
        const cancelEditBtn = document.getElementById('cancelEditBtn');
        const saveEditBtn = document.getElementById('saveEditBtn');

        function closeEditModal() {
            if (editModal) editModal.style.display = 'none';
        }

        document.querySelectorAll('.open-edit-user-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                const userId = btn.dataset.id;
                const name = btn.dataset.name;
                const role = btn.dataset.role;
                const quota = btn.dataset.quota;

                editUserId.value = userId;
                editUserName.value = name;
                editUserRole.value = role;
                if (editUserQuota && quota) editUserQuota.value = quota;

                if (editModal) editModal.style.display = 'flex';
            });
        });

        if (closeEditBtn) closeEditBtn.addEventListener('click', closeEditModal);
        if (cancelEditBtn) cancelEditBtn.addEventListener('click', closeEditModal);

        if (editForm) {
            editForm.addEventListener('submit', async (e) => {
                e.preventDefault();
                const userId = editUserId.value;
                const newRole = editUserRole.value;
                const newQuota = editUserQuota.value;

                saveEditBtn.disabled = true;
                saveEditBtn.textContent = 'กำลังบันทึก...';

                try {
                    const res = await fetch(`/api/admin/users/${userId}`, {
                        method: 'PATCH',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ role: newRole, quota: Number(newQuota) })
                    });
                    const data = await res.json();
                    if (!res.ok || !data.success) {
                        throw new Error(data.error || 'Failed to update user');
                    }

                    // Update DOM row
                    const row = document.querySelector(`.user-row[data-id="${userId}"]`);
                    if (row) {
                        row.dataset.role = newRole;
                        const badge = row.querySelector('.badge');
                        if (badge) {
                            badge.className = `badge ${newRole === 'admin' ? 'badge-admin' : 'badge-user'}`;
                            badge.textContent = newRole === 'admin' ? 'Admin' : 'User';
                        }
                    }

                    if (window.showToast) window.showToast(`Updated "${editUserName.value}" successfully!`, 'success');
                    closeEditModal();
                } catch (err) {
                    console.error('Update user error:', err);
                    if (window.showToast) window.showToast(`Error: ${err.message}`, 'error');
                } finally {
                    saveEditBtn.disabled = false;
                    saveEditBtn.textContent = 'บันทึกการเปลี่ยนแปลง';
                }
            });
        }

        // 4. Delete User Logic
        document.querySelectorAll('.delete-user-btn').forEach(btn => {
            btn.addEventListener('click', async () => {
                const userId = btn.dataset.id;
                const name = btn.dataset.name;

                if (!confirm(`คุณแน่ใจหรือไม่ว่าต้องการลบผู้ใช้ "${name}"?`)) {
                    return;
                }

                btn.disabled = true;
                btn.textContent = '...';

                try {
                    const res = await fetch(`/api/admin/users/${userId}`, {
                        method: 'DELETE'
                    });
                    const data = await res.json();
                    if (!res.ok || !data.success) {
                        throw new Error(data.error || 'Failed to delete user');
                    }

                    const row = document.querySelector(`.user-row[data-id="${userId}"]`);
                    if (row) {
                        row.style.transition = 'opacity 0.3s, transform 0.3s';
                        row.style.opacity = '0';
                        row.style.transform = 'translateX(20px)';
                        setTimeout(() => row.remove(), 300);
                    }

                    if (window.showToast) window.showToast(`User "${name}" deleted successfully!`, 'success');

                    // Update total user counter
                    const totalEl = document.getElementById('totalUsersStat');
                    if (totalEl) totalEl.textContent = Math.max(0, parseInt(totalEl.textContent) - 1);
                } catch (err) {
                    console.error('Delete user error:', err);
                    if (window.showToast) window.showToast(`Error: ${err.message}`, 'error');
                    btn.disabled = false;
                    btn.textContent = 'ลบ';
                }
            });
        });
    });
    </script>

</body>
