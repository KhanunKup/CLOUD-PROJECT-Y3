<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>User Management — EasyDrive</title>
    
    <!-- FontAwesome for icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    
    <!-- Core styles & theme -->
    <link rel="stylesheet" href="/css/menu.css">
    <link rel="stylesheet" href="/css/homepage.css">

    <style>
        body {
            font-family: 'Outfit', 'Kanit', sans-serif;
            background-color: #CEB59E;
            margin: 0;
            min-height: 100vh;
        }

        /* ─── Main Content & Card ─── */
        .content-card {
            background-color: #f5f0eb;
            border: 1px solid rgba(132, 97, 69, 0.16);
            border-radius: 20px;
            width: 100%;
            padding: 30px;
            box-shadow: 0 10px 30px rgba(58, 38, 26, 0.08);
            box-sizing: border-box;
        }

        /* Card Header */
        .card-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            border-bottom: 2px solid #e2d5ca;
            padding-bottom: 20px;
            margin-bottom: 24px;
        }

        .card-title-group h1 {
            font-family: 'Outfit', 'Kanit', sans-serif;
            font-size: 32px;
            font-weight: 800;
            color: #423E3B;
            margin: 0 0 6px 0;
            line-height: 1.2;
            letter-spacing: -0.5px;
        }

        .card-title-group p {
            font-family: 'Outfit', 'Kanit', sans-serif;
            color: #7a6552;
            font-size: 14px;
            margin: 0;
        }

        .header-icon svg {
            width: 44px;
            height: 44px;
            fill: #7d5534;
        }

        /* ─── Toolbar ─── */
        .toolbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 20px;
            margin-bottom: 24px;
        }

        .filter-section {
            display: flex;
            flex-direction: column;
            gap: 10px;
            flex: 1;
            min-width: 280px;
            max-width: 460px;
        }

        .filter-section input {
            padding: 12px 20px;
            border-radius: 12px;
            border: 1.5px solid #d1bdae;
            background-color: #fff;
            width: 100%;
            font-family: 'Outfit', 'Kanit', sans-serif;
            font-size: 14px;
            color: #44362A;
            box-sizing: border-box;
            outline: none;
            transition: border-color 0.2s, box-shadow 0.2s;
        }

        .filter-section input:focus {
            border-color: #c4a071;
            box-shadow: 0 0 0 2px rgba(196, 160, 113, 0.25);
        }

        .filter-buttons {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }

        .filter-dropdown {
            padding: 8px 16px;
            border-radius: 20px;
            border: 1.5px solid #d1bdae;
            background-color: #fff;
            cursor: pointer;
            font-size: 13px;
            color: #554335;
            font-weight: 600;
            font-family: 'Outfit', 'Kanit', sans-serif;
            outline: none;
            box-shadow: 0 2px 5px rgba(0,0,0,0.02);
            transition: border-color 0.2s, box-shadow 0.2s;
        }

        .filter-dropdown:focus {
            border-color: #c4a071;
            box-shadow: 0 0 0 2px rgba(196, 160, 113, 0.25);
        }

        /* ─── Stats Section ─── */
        .stats-section {
            display: flex;
            gap: 15px;
            flex-wrap: wrap;
        }

        .stat-box {
            background-color: #fff;
            border: 1px solid rgba(132, 97, 69, 0.12);
            border-radius: 14px;
            padding: 14px 22px;
            display: flex;
            align-items: center;
            gap: 14px;
            box-shadow: 0 4px 10px rgba(58, 38, 26, 0.04);
            min-width: 140px;
        }

        .stat-box svg {
            width: 28px;
            height: 28px;
            fill: #7d5534;
        }

        .stat-info {
            text-align: center;
        }

        .stat-number {
            font-family: 'Outfit', sans-serif;
            font-size: 1.5rem;
            font-weight: 800;
            line-height: 1;
        }

        .stat-label {
            font-size: 12px;
            color: #7a6552;
            margin-top: 4px;
            font-weight: 500;
        }

        .text-orange { color: #d96523; }
        .text-purple { color: #8e24aa; }
        .text-green { color: #43a047; }

        /* ─── Data Table ─── */
        .table-container {
            background-color: #fff;
            border: 1px solid rgba(132, 97, 69, 0.15);
            border-radius: 14px;
            overflow-x: auto;
            box-shadow: 0 4px 14px rgba(58, 38, 26, 0.03);
        }

        table {
            width: 100%;
            border-collapse: collapse;
            font-family: 'Outfit', 'Kanit', sans-serif;
        }

        th, td {
            padding: 14px 18px;
            text-align: left;
            border-bottom: 1px solid #eee5dc;
            font-size: 14px;
        }

        th {
            background-color: #f8f4ef;
            color: #5a3e26;
            font-weight: 700;
            font-size: 13px;
            letter-spacing: 0.3px;
            text-transform: uppercase;
        }

        tr.user-row {
            transition: background-color 0.15s;
        }

        tr.user-row:hover {
            background-color: #fdfaf6;
        }
        
        .user-cell {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .user-avatar {
            width: 38px;
            height: 38px;
            background: linear-gradient(145deg, #e7c18e, #c79b67);
            border-radius: 50%;
            display: flex;
            justify-content: center;
            align-items: center;
            flex-shrink: 0;
            box-shadow: 0 2px 6px rgba(84, 56, 34, 0.15);
        }

        .user-avatar svg {
            width: 20px;
            height: 20px;
            fill: #4e3e2e;
        }

        .user-name-email {
            display: flex;
            flex-direction: column;
            gap: 2px;
        }

        .user-name-email strong {
            color: #3b2c20;
            font-size: 14px;
            font-weight: 600;
        }

        .user-name-email span {
            color: #8c7b6d;
            font-size: 12px;
        }

        /* ─── Badges (Role & Status) ─── */
        .badge {
            padding: 4px 14px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 700;
            border: 1px solid #d1bdae;
            background-color: #fff;
            display: inline-block;
            text-align: center;
            min-width: 65px;
        }

        .badge-admin {
            color: #c62828;
            background-color: #ffebee;
            border-color: #ffcdd2;
        }

        .badge-user {
            color: #44362a;
            background-color: #f5f0eb;
            border-color: #d8c7b8;
        }

        .badge-status {
            padding: 4px 12px;
            border-radius: 12px;
            font-size: 12px;
            font-weight: 700;
            display: inline-block;
        }

        .status-active {
            background-color: #e8f5e9;
            color: #2e7d32;
            border: 1px solid #c8e6c9;
        }

        .status-inactive {
            background-color: #ffebee;
            color: #c62828;
            border: 1px solid #ffcdd2;
        }

        .date-text {
            color: #44362A;
            font-weight: 600;
            font-size: 13px;
        }

        /* ─── Action Buttons ─── */
        .action-btns {
            display: flex;
            gap: 8px;
        }

        .btn-edit, .btn-delete {
            padding: 6px 16px;
            border-radius: 20px;
            border: none;
            color: white;
            cursor: pointer;
            font-family: 'Outfit', 'Kanit', sans-serif;
            font-size: 13px;
            font-weight: 600;
            transition: opacity 0.18s, transform 0.1s;
        }

        .btn-edit:hover, .btn-delete:hover {
            opacity: 0.9;
            transform: translateY(-1px);
        }

        .btn-edit {
            background: linear-gradient(135deg, #7d5534, #614024);
        }

        .btn-delete {
            background: linear-gradient(135deg, #d32f2f, #b71c1c);
        }

        /* ─── Pagination ─── */
        .pagination {
            display: flex;
            justify-content: flex-end;
            align-items: center;
            padding: 20px 0 0 0;
            gap: 6px;
        }

        .page-btn, .page-num {
            padding: 6px 14px;
            border-radius: 10px;
            background-color: #fff;
            border: 1.5px solid #d1bdae;
            cursor: pointer;
            font-family: 'Outfit', 'Kanit', sans-serif;
            font-size: 13px;
            font-weight: 600;
            color: #554335;
            transition: background 0.15s, border-color 0.15s;
        }

        .page-btn:hover, .page-num:hover {
            border-color: #c4a071;
            background-color: #faf6f0;
        }

        .page-num.active {
            background-color: #7d5534;
            color: #fff;
            border-color: #7d5534;
        }
    </style>
</head>
<body>

<div class="page-layout">

    <!-- Left Navigation Sidebar -->
    <%- include('../partials/nav/sidebar', { currentPage: 'management', user: typeof user !== 'undefined' ? user : null }) %>
    <div class="sidebar-spacer"></div>

    <!-- Main Content -->
    <main class="main-content">
        <div class="content-card">
            
            <!-- Card Header -->
            <div class="card-header">
                <div class="card-title-group">
                    <h1>User Management</h1>
                    <p>Manage all system users, roles, and storage quotas</p>
                </div>
                <div class="header-icon">
                    <svg viewBox="0 0 24 24"><path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"/></svg>
                </div>
            </div>

            <!-- Toolbar & Stats -->
            <div class="toolbar">
                <div class="filter-section">
                    <input type="text" id="userSearchInput" placeholder="Search users by name or email...">
                    <div class="filter-buttons">
                        <select id="roleFilter" class="filter-dropdown">
                            <option value="all">ROLE: All</option>
                            <option value="admin">ROLE: Admin</option>
                            <option value="user">ROLE: User</option>
                        </select>
                        <select id="statusFilter" class="filter-dropdown">
                            <option value="all">STATUS: All</option>
                            <option value="active">STATUS: Active</option>
                            <option value="inactive">STATUS: Inactive</option>
                        </select>
                    </div>
                </div>
                
                <div class="stats-section">
                    <div class="stat-box">
                        <svg viewBox="0 0 24 24"><path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"/></svg>
                        <div class="stat-info">
                            <div class="stat-number text-orange" id="totalUsersStat"><%= typeof totalUsers !== 'undefined' ? totalUsers : 0 %></div>
                            <div class="stat-label">Total Users</div>
                        </div>
                    </div>
                    <div class="stat-box">
                        <svg viewBox="0 0 24 24"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 10.99h7c-.53 4.12-3.28 7.79-7 8.94V12H5V6.3l7-3.11v8.8z"/></svg>
                        <div class="stat-info">
                            <div class="stat-number text-purple" id="adminsStat"><%= typeof adminCount !== 'undefined' ? adminCount : 0 %></div>
                            <div class="stat-label">Admins</div>
                        </div>
                    </div>
                    <div class="stat-box">
                        <svg viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zM4 12c0-.61.08-1.21.21-1.78L8.99 15v1c0 1.1.9 2 2 2v1.93C7.06 19.43 4 16.05 4 12zm13.89 5.4c-.26-.81-1-1.4-1.9-1.4h-1v-3c0-.55-.45-1-1-1h-6v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41C17.92 5.77 20 8.65 20 12c0 2.08-.81 3.98-2.11 5.4z"/></svg>
                        <div class="stat-info">
                            <div class="stat-number text-green" id="normalUsersStat"><%= typeof userCount !== 'undefined' ? userCount : 0 %></div>
                            <div class="stat-label">Standard Users</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Data Table -->
            <div class="table-container">
                <table>
                    <thead>
                        <tr>
                            <th>User</th>
                            <th>Role</th>
                            <th>Status</th>
                            <th>Created Date</th>
                            <th>Storage Used</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody id="userTableBody">
                        <% if (typeof users !== 'undefined' && users && users.length > 0) { %>
                            <% users.forEach(function(u) { %>
                                <tr class="user-row" data-id="<%= u.user_id %>" data-name="<%= (u.name || '').toLowerCase() %>" data-email="<%= (u.email || '').toLowerCase() %>" data-role="<%= u.role %>" data-status="<%= u.status || 'active' %>">
                                    <td>
                                        <div class="user-cell">
                                            <div class="user-avatar"><svg viewBox="0 0 24 24"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg></div>
                                            <div class="user-name-email">
                                                <strong><%= u.name %></strong>
                                                <span><%= u.email %></span>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge <%= u.role === 'admin' ? 'badge-admin' : 'badge-user' %>"><%= u.role === 'admin' ? 'Admin' : 'User' %></span>
                                    </td>
                                    <td>
                                        <span class="badge-status <%= (u.status || 'active') === 'active' ? 'status-active' : 'status-inactive' %>">
                                            <%= (u.status || 'active') === 'active' ? 'Active' : 'Inactive' %>
                                        </span>
                                    </td>
                                    <td class="date-text"><%= new Date(u.created_at).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }) %></td>
                                    <td class="date-text"><%= u.storageFormatted || '0 B' %></td>
                                    <td>
                                        <div class="action-btns">
                                            <button type="button" class="btn-edit open-edit-user-btn" 
                                                    data-id="<%= u.user_id %>" 
                                                    data-name="<%= u.name %>" 
                                                    data-role="<%= u.role %>" 
                                                    data-status="<%= u.status || 'active' %>"
                                                    data-quota="<%= u.quota %>">Edit</button>
                                            <% if (typeof user !== 'undefined' && user && user.user_id === u.user_id) { %>
                                                <button type="button" class="btn-delete" style="opacity: 0.4; cursor: not-allowed;" title="Cannot delete your own account" disabled>Delete</button>
                                            <% } else { %>
                                                <button type="button" class="btn-delete delete-user-btn" data-id="<%= u.user_id %>" data-name="<%= u.name %>">Delete</button>
                                            <% } %>
                                        </div>
                                    </td>
                                </tr>
                            <% }); %>
                        <% } else { %>
                            <tr>
                                <td colspan="6" style="text-align: center; padding: 30px; color: #888;">No users found in the system</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            <div class="pagination">
                <span id="showingCount" style="margin-right: auto; font-size: 13px; color: #7a6552; font-weight: 500;">
                    Showing <%= typeof users !== 'undefined' ? users.length : 0 %> users
                </span>
                <button class="page-btn">Previous</button>
                <button class="page-num active">1</button>
                <button class="page-btn">Next</button>
            </div>

        </div>
    </main>
</div>

<!-- Edit User Modal -->
<div id="editUserModal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 1000; align-items: center; justify-content: center;">
    <div style="background: #fff; width: 440px; border-radius: 16px; padding: 25px; box-shadow: 0 10px 30px rgba(0,0,0,0.2); font-family: 'Outfit', 'Kanit', sans-serif;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
            <h3 style="margin: 0; color: #423E3B; font-size: 18px; font-weight: 700;" id="editModalTitle">Edit User Permissions & Quota</h3>
            <button type="button" id="closeEditModalBtn" style="background: none; border: none; font-size: 22px; cursor: pointer; color: #888;">&times;</button>
        </div>
        
        <form id="editUserForm">
            <input type="hidden" id="editUserId">
            
            <div style="margin-bottom: 16px;">
                <label style="display: block; font-size: 13px; font-weight: 600; color: #554335; margin-bottom: 6px;">Username:</label>
                <input type="text" id="editUserName" style="width: 100%; padding: 10px 14px; border: 1.5px solid #d1bdae; border-radius: 10px; box-sizing: border-box; background: #f9f9f9; font-family: inherit;" readonly>
            </div>

            <div style="margin-bottom: 16px;">
                <label style="display: block; font-size: 13px; font-weight: 600; color: #554335; margin-bottom: 6px;">Role:</label>
                <select id="editUserRole" style="width: 100%; padding: 10px 14px; border: 1.5px solid #d1bdae; border-radius: 10px; box-sizing: border-box; font-size: 14px; outline: none; font-family: inherit;">
                    <option value="user">User (Standard)</option>
                    <option value="admin">Admin (Administrator)</option>
                </select>
            </div>

            <div style="margin-bottom: 16px;">
                <label style="display: block; font-size: 13px; font-weight: 600; color: #554335; margin-bottom: 6px;">Account Status:</label>
                <select id="editUserStatus" style="width: 100%; padding: 10px 14px; border: 1.5px solid #d1bdae; border-radius: 10px; box-sizing: border-box; font-size: 14px; outline: none; font-family: inherit;">
                    <option value="active">Active</option>
                    <option value="inactive">Inactive</option>
                </select>
            </div>

            <div style="margin-bottom: 24px;">
                <label style="display: block; font-size: 13px; font-weight: 600; color: #554335; margin-bottom: 6px;">Storage Quota:</label>
                <select id="editUserQuota" style="width: 100%; padding: 10px 14px; border: 1.5px solid #d1bdae; border-radius: 10px; box-sizing: border-box; font-size: 14px; outline: none; font-family: inherit;">
                    <option value="16106127360">15 GB</option>
                    <option value="26843545600">25 GB</option>
                    <option value="53687091200" selected>50 GB (Default)</option>
                    <option value="107374182400">100 GB</option>
                    <option value="214748364800">200 GB</option>
                </select>
            </div>

            <div style="display: flex; gap: 10px; justify-content: flex-end;">
                <button type="button" id="cancelEditBtn" style="padding: 10px 20px; border-radius: 20px; border: 1.5px solid #d1bdae; background: #fff; cursor: pointer; font-family: inherit; font-weight: 600; color: #554335;">Cancel</button>
                <button type="submit" id="saveEditBtn" style="padding: 10px 24px; border-radius: 20px; border: none; background: #7d5534; color: white; cursor: pointer; font-family: inherit; font-weight: 700;">Save Changes</button>
            </div>
        </form>
    </div>
</div>

<!-- Scripts: Toast, Realtime search, Edit & Delete -->
<script src="/js/toast.js"></script>
<script>
document.addEventListener('DOMContentLoaded', () => {
    // 1. Search & Dropdown Filters
    const searchInput = document.getElementById('userSearchInput') || document.querySelector('.filter-section input');
    const roleSelect = document.getElementById('roleFilter');
    const statusSelect = document.getElementById('statusFilter');
    const userRows = document.querySelectorAll('.user-row');

    function filterUsers() {
        const query = searchInput ? searchInput.value.toLowerCase().trim() : '';
        const selectedRole = roleSelect ? roleSelect.value : 'all';
        const selectedStatus = statusSelect ? statusSelect.value : 'all';
        let visibleCount = 0;

        userRows.forEach(row => {
            const name = row.dataset.name || '';
            const email = row.dataset.email || '';
            const role = row.dataset.role || '';
            const status = row.dataset.status || 'active';

            const matchesQuery = !query || name.includes(query) || email.includes(query);
            const matchesRole = selectedRole === 'all' || role === selectedRole;
            const matchesStatus = selectedStatus === 'all' || status === selectedStatus;

            if (matchesQuery && matchesRole && matchesStatus) {
                row.style.display = '';
                visibleCount++;
            } else {
                row.style.display = 'none';
            }
        });

        const countEl = document.getElementById('showingCount');
        if (countEl) countEl.textContent = `Showing ${visibleCount} users`;
    }

    if (searchInput) searchInput.addEventListener('input', filterUsers);
    if (roleSelect) roleSelect.addEventListener('change', filterUsers);
    if (statusSelect) statusSelect.addEventListener('change', filterUsers);

    // 2. Edit User Modal & Logic
    const editModal = document.getElementById('editUserModal');
    const closeEditBtn = document.getElementById('closeEditModalBtn');
    const cancelEditBtn = document.getElementById('cancelEditBtn');
    const editForm = document.getElementById('editUserForm');

    const editUserId = document.getElementById('editUserId');
    const editUserName = document.getElementById('editUserName');
    const editUserRole = document.getElementById('editUserRole');
    const editUserStatus = document.getElementById('editUserStatus');
    const editUserQuota = document.getElementById('editUserQuota');

    function closeEditModal() {
        if (editModal) editModal.style.display = 'none';
    }

    if (closeEditBtn) closeEditBtn.addEventListener('click', closeEditModal);
    if (cancelEditBtn) cancelEditBtn.addEventListener('click', closeEditModal);
    if (editModal) {
        editModal.addEventListener('click', (e) => {
            if (e.target === editModal) closeEditModal();
        });
    }

    document.querySelectorAll('.open-edit-user-btn').forEach(btn => {
        btn.addEventListener('click', () => {
            editUserId.value = btn.dataset.id;
            editUserName.value = btn.dataset.name;
            editUserRole.value = btn.dataset.role;
            editUserStatus.value = btn.dataset.status || 'active';
            if (btn.dataset.quota) {
                editUserQuota.value = btn.dataset.quota;
            }
            if (editModal) editModal.style.display = 'flex';
        });
    });

    // 3. Save User Changes
    if (editForm) {
        editForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            const saveEditBtn = document.getElementById('saveEditBtn');
            saveEditBtn.disabled = true;
            saveEditBtn.textContent = 'Saving...';

            const userId = editUserId.value;
            const newRole = editUserRole.value;
            const newStatus = editUserStatus.value;
            const newQuota = parseInt(editUserQuota.value);

            try {
                const res = await fetch(`/api/admin/users/${userId}`, {
                    method: 'PATCH',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        role: newRole,
                        status: newStatus,
                        quota: newQuota
                    })
                });

                const data = await res.json();
                if (!res.ok || !data.success) {
                    throw new Error(data.error || 'Failed to update user');
                }

                // Update UI in Table
                const row = document.querySelector(`.user-row[data-id="${userId}"]`);
                if (row) {
                    row.dataset.role = newRole;
                    row.dataset.status = newStatus;
                    const roleBadge = row.querySelector('.badge');
                    if (roleBadge) {
                        roleBadge.className = `badge ${newRole === 'admin' ? 'badge-admin' : 'badge-user'}`;
                        roleBadge.textContent = newRole === 'admin' ? 'Admin' : 'User';
                    }
                    const statusBadge = row.querySelector('.badge-status');
                    if (statusBadge) {
                        statusBadge.className = `badge-status ${newStatus === 'active' ? 'status-active' : 'status-inactive'}`;
                        statusBadge.textContent = newStatus === 'active' ? 'Active' : 'Inactive';
                    }
                    const editBtn = row.querySelector('.open-edit-user-btn');
                    if (editBtn) {
                        editBtn.dataset.role = newRole;
                        editBtn.dataset.status = newStatus;
                        editBtn.dataset.quota = newQuota;
                    }
                }

                if (window.showToast) window.showToast(`Updated "${editUserName.value}" successfully!`, 'success');
                closeEditModal();
                filterUsers();
            } catch (err) {
                console.error('Update user error:', err);
                if (window.showToast) window.showToast(`Error: ${err.message}`, 'error');
            } finally {
                saveEditBtn.disabled = false;
                saveEditBtn.textContent = 'Save Changes';
            }
        });
    }

    // 4. Delete User Logic
    document.querySelectorAll('.delete-user-btn').forEach(btn => {
        btn.addEventListener('click', async () => {
            const userId = btn.dataset.id;
            const name = btn.dataset.name;

            if (!confirm(`Are you sure you want to delete user "${name}"?`)) {
                return;
            }

            btn.disabled = true;
            btn.textContent = '...';

            try {
                const res = await fetch(`/api/admin/users/${userId}`, {
                    method: 'DELETE'
                });
                const data = await res.json();
                if (!res.ok || !data.success) {
                    throw new Error(data.error || 'Failed to delete user');
                }

                const row = document.querySelector(`.user-row[data-id="${userId}"]`);
                if (row) {
                    row.style.transition = 'opacity 0.3s, transform 0.3s';
                    row.style.opacity = '0';
                    row.style.transform = 'translateX(20px)';
                    setTimeout(() => row.remove(), 300);
                }

                if (window.showToast) window.showToast(`User "${name}" deleted successfully!`, 'success');

                // Update total user counter
                const totalEl = document.getElementById('totalUsersStat');
                if (totalEl) totalEl.textContent = Math.max(0, parseInt(totalEl.textContent) - 1);
            } catch (err) {
                console.error('Delete user error:', err);
                if (window.showToast) window.showToast(`Error: ${err.message}`, 'error');
                btn.disabled = false;
                btn.textContent = 'Delete';
            }
        });
    });
});
</script>

<%- include('../modals/storage-modal') %>
<script src="/js/storage-modal.js"></script>
</body>
</html>
